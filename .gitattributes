*.usd filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# materials.usd is kept ASCII under its original .usd name (7 binary CAD parts
# sublayer it by name, so renaming it would force re-saving those crates).
# This override must stay AFTER the blanket *.usd rule so it wins.
grippers/Robotiq_2F_85/materials/materials.usd !filter !diff !merge text
grippers/Robotiq_2F_140/materials/materials.usd !filter !diff !merge text

# demo videos
grippers/demo/rl/docs/*.mp4 filter=lfs diff=lfs merge=lfs -text
grippers/demo/rl/**/*.pt filter=lfs diff=lfs merge=lfs -text
