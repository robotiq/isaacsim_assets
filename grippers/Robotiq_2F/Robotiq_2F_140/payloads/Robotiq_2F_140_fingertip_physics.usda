#usda 1.0
(
    # Engine-neutral fingertip physics for the 2F-140 (UsdPhysics only, no Physx*/Newton*):
    # the screwed-on fingertip rigid bodies, their PhysicsFixedJoints (welded to
    # inner_finger, rigid like a screw) and the default Flat-Overmolded pad mass/inertia.
    # Sublayered by every Physics variant (PhysX and Newton alike), so it lives here once.
    # All link frames are identity/world, so the welds use identity local frames. The
    # PhysX tip colliders live in Robotiq_2F_140_physx_common_physics.usda.
    #
    # Mass/inertia for the Flat-Overmolded pad are authored here (not in the
    # "Fingertip" variantSet) so they are reachable on the configuration/
    # integration path, which sublayers this payload + base.usda but never
    # Robotiq_2F_140.usda. The Silicone / V-Groove / Tactile_TSF140 Fingertip
    # variants override them with their own values. This layer is only sublayered by
    # Physics variants, so it never composes under Physics = "None".
    #
    # Pad mass/CoM: CoM is the baked pad geometry centre; mass + inertia are
    # box-model estimates for the overmolded pad (refine against CAD if needed).
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        over "left_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {
            point3f physics:centerOfMass = (0, -0.0799, 0.1768)
            float3 physics:diagonalInertia = (0.0000153, 0.0000036, 0.0000165)
            float physics:mass = 0.04
            quatf physics:principalAxes = (1, 0, 0, 0)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/left_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "right_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {
            point3f physics:centerOfMass = (0, 0.0793, 0.1772)
            float3 physics:diagonalInertia = (0.0000153, 0.0000036, 0.0000165)
            float physics:mass = 0.04
            quatf physics:principalAxes = (1, 0, 0, 0)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/right_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}
