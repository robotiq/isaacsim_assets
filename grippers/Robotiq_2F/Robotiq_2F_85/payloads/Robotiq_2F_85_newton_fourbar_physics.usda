#usda 1.0
(
    defaultPrim = "Robotiq_2F_85"
    doc = """Shared Newton (MuJoCo-Warp) finger-linkage physics for the Robotiq 2F-85,
common to every Newton grip formulation (newton_compliant, newton_parallel_grip, ...).

Single source of truth for the closed finger linkage (a five-bar; a four-bar once
newton_parallel_grip welds the outer finger) + its MuJoCo solver tuning that
is IDENTICAL across those variants: the finger_joint driver, the right_outer_knuckle
NewtonMimic, the pad preload springs on the inner_finger joints (the same joint and
preload as PhysX), the loop_closure spherical equalities (MjcEqualityConnectAPI) that
close the linkage loop at the inner_finger <-> inner_knuckle pin in place of the
inner_finger_knuckle revolutes, and the
per-material / per-mesh MuJoCo tuning (MjcMaterialAPI,
MjcCollisionAPI).

Each Newton variant payload sublayers this (stronger than kinematics, so these overlays
win over the neutral joint defs) and adds ONLY its variant-specific distal-coupler delta:
  * newton_compliant:     left/right_outer_finger_joint as live revolute couplers
                          (the five-bar's second DOF -> encompassing grip).
  * newton_parallel_grip: left/right_outer_finger_joint SUPPRESSED (active=false) +
                          outer_finger WELDED to outer_knuckle (distal DOF removed
                          -> parallel grip).

Rigid-body mass / inertia / colliders / pad material are the Newton-pure shared values in
./Robotiq_2F_85_newton_common_physics.usda (fingertip bodies + welds: the engine-neutral
./Robotiq_2F_85_fingertip_physics.usda); the neutral
joint frames/limits/bodies are in ./Robotiq_2F_85_kinematics_physics.usda. This layer
carries the Mjc* solver tuning for both, so newton_common stays Newton-pure (RV.011).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # The articulation root and root_joint are the shared neutral defs in
        # ./Robotiq_2F_85_kinematics_physics.usda.

        # Joint frames/limits/bodies + PhysicsJointStateAPI are the shared neutral defs
        # in ./Robotiq_2F_85_kinematics_physics.usda (sublayered weaker than this). These
        # overlays add ONLY the Newton/MuJoCo engine physics: the finger_joint driver,
        # the right_outer_knuckle NewtonMimic, mjc solver params, and the pad preload
        # springs on the inner_finger joints (same joint and same preload as PhysX).
        # Newton closes the linkage loop with the loop_closure spherical equalities below
        # (kept local) at the inner_finger <-> inner_knuckle pin, instead of the
        # inner_finger_knuckle revolutes -> those are suppressed (active=false).
        # left/right_outer_finger_joint is NOT touched here -- its treatment is the
        # per-variant delta.
        over "Joints"
        {
            over "finger_joint" (
                prepend apiSchemas = ["MjcJointAPI", "PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 2.7576203
                float drive:angular:physics:maxForce = 15
                float drive:angular:physics:stiffness = 24.993114
                float drive:angular:physics:targetPosition = 0
                uniform double mjc:armature = 0.3
                uniform double mjc:damping = 0.1
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            over "right_outer_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                uniform double[] mjc:solreflimit = [0.02, 2]
                rel mjc:target = </Robotiq_2F_85/Robotiq_2F_85/Joints/finger_joint>
                rel newton:mimicJoint = </Robotiq_2F_85/Robotiq_2F_85/Joints/finger_joint>
            }

            over "left_inner_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            over "right_inner_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            # PhysX loop revolutes Newton replaces with the loop_closure spherical
            # equalities (below) -> suppressed. The tree is then base -> outer_knuckle ->
            # outer_finger -> inner_finger (pad) and base -> inner_knuckle, exactly the
            # PhysX body order, so no joint needs its bodies swapped for Newton.
            over "left_inner_finger_knuckle_joint" (active = false) {}
            over "right_inner_finger_knuckle_joint" (active = false) {}

            # The pad joints (outer_finger -> inner_finger), live as on PhysX, carrying
            # the documented 2F-85 spring: 0.0004 N.m/deg = 0.0229 N.m/rad with springref
            # +/-1.5708 rad (90 deg preload, PhysX sign), ~37 N.mm at the stop. It holds the
            # pad against the outer_finger_joint 0 deg limit (parallel) until the object
            # pushes it off. The passive loop joints run without joint damping (tuned live).
            over "left_inner_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
                uniform double mjc:springref = 1.5708
                uniform double mjc:stiffness = 0.0229
            }

            over "right_inner_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
                uniform double mjc:springref = -1.5708
                uniform double mjc:stiffness = 0.0229
            }


            def PhysicsSphericalJoint "right_loop_closure" (
                prepend apiSchemas = ["MjcEqualityConnectAPI"]
            )
            {
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_knuckle>
                uniform bool physics:excludeFromArticulation = 1
                point3f physics:localPos0 = (0, 0.04986, 0.1046)
                point3f physics:localPos1 = (0, 0.04986, 0.1046)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsSphericalJoint "left_loop_closure" (
                prepend apiSchemas = ["MjcEqualityConnectAPI"]
            )
            {
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_knuckle>
                uniform bool physics:excludeFromArticulation = 1
                point3f physics:localPos0 = (0, -0.04986, 0.1046)
                point3f physics:localPos1 = (0, -0.04986, 0.1046)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
            }
        }

        # MuJoCo pad-material tuning on top of the shared Newton GripMaterial. Nested under the inner prim on purpose: the scope is
        # /Robotiq_2F_85/Robotiq_2F_85/Physics (an `over` one level up composes nothing).
        over "Physics"
        {
            over "GripMaterial" (
                prepend apiSchemas = ["MjcMaterialAPI"]
            )
            {
            }
        }
    }
}

# MuJoCo per-mesh solver tuning on top of the shared Newton convex-hull colliders.
over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:condim = 3
                uniform double mjc:gap = 0
                uniform int mjc:group = 2
                uniform double mjc:margin = 0
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double mjc:solmix = 1
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                # Excluded from collision with the inner_finger: the pair's hulls overlap at the
                # knuckle pin and they are joined only by the loop_closure equality. Newton's importer
                # honours physics:filteredPairs on the collider prim (target = the instance-proxy path
                # of the other collider). Do not use a PhysicsCollisionGroup for this: Newton gives
                # ungrouped shapes group 1, so a grouped knuckle would collide with nothing else.
                # The collider is one shared prototype for both sides, so both fingers are
                # listed (the cross-side pair is far apart and never in contact anyway).
                prepend rel physics:filteredPairs = [
                    </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger/visuals/Defeatured_2F_85_PAD_OPEN_finger4step_01/Defeatured_2F_85_PAD_OPEN_finger4step>,
                    </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger/visuals/Defeatured_2F_85_PAD_OPEN_finger4step_01/Defeatured_2F_85_PAD_OPEN_finger4step>,
                ]
                uniform int mjc:condim = 3
                uniform double mjc:gap = 0
                uniform int mjc:group = 2
                uniform double mjc:margin = 0
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double mjc:solmix = 1
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                # Excluded from collision with the inner knuckles (PhysX has articulation
                # self-collision off, so the knuckle touches only objects). Authored here, not on
                # the knuckle, so it stays inert for fingertip variants that are not selected.
                # One shared prototype for both sides: both knuckles are listed.
                prepend rel physics:filteredPairs = [
                    </Robotiq_2F_85/Robotiq_2F_85/left_inner_knuckle/visuals/Defeatured_2F_85_PAD_OPEN_finger3step_01/Defeatured_2F_85_PAD_OPEN_finger3step>,
                    </Robotiq_2F_85/Robotiq_2F_85/right_inner_knuckle/visuals/Defeatured_2F_85_PAD_OPEN_finger3step_01/Defeatured_2F_85_PAD_OPEN_finger3step>,
                ]
                uniform int mjc:group = 3
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.004, 2]
            }
        }

        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                # Excluded from collision with the inner knuckles (PhysX has articulation
                # self-collision off, so the knuckle touches only objects). Authored here, not on
                # the knuckle, so it stays inert for fingertip variants that are not selected.
                # One shared prototype for both sides: both knuckles are listed.
                prepend rel physics:filteredPairs = [
                    </Robotiq_2F_85/Robotiq_2F_85/left_inner_knuckle/visuals/Defeatured_2F_85_PAD_OPEN_finger3step_01/Defeatured_2F_85_PAD_OPEN_finger3step>,
                    </Robotiq_2F_85/Robotiq_2F_85/right_inner_knuckle/visuals/Defeatured_2F_85_PAD_OPEN_finger3step_01/Defeatured_2F_85_PAD_OPEN_finger3step>,
                ]
                uniform int mjc:group = 3
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }
}
