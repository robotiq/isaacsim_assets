#usda 1.0
(
    doc = """Scene-level Newton setting the Robotiq grippers need on Isaac Sim 6.1+.
Sublayer this into the stage that holds a gripper. It only adds opinions on the prim
/PhysicsScene, so it merges with your scene ONLY if that scene is at exactly /PhysicsScene;
otherwise set mjc:option:cone = "elliptic" (with MjcSceneAPI) on your own scene instead.
See GRIPPER_SIMULATION_GUIDE.md section 5.3."""
)

def PhysicsScene "PhysicsScene" (
    prepend apiSchemas = ["MjcSceneAPI"]
)
{
    # Elliptic friction cone: what Isaac Sim 6.0.1 forced, and 6.1+ no longer does.
    # The gripper pad material's negative newton:contactFrictionGain relies on it.
    uniform token mjc:option:cone = "elliptic"
}
