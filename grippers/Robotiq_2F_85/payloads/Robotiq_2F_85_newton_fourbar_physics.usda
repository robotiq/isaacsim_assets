#usda 1.0
(
    # Newton (MuJoCo-Warp) four-bar physics of the 2F-85, shared by Newton_compliant and
    # Newton_parallel_grip: the finger_joint driver, the right_outer_knuckle NewtonMimic,
    # the pad springs on the inner_finger joints (same joint and preload as PhysX), the
    # loop_closure spherical equalities (MjcEqualityConnectAPI) that close the four-bar at
    # the inner_finger <-> inner_knuckle pin in place of the inner_finger_knuckle revolutes,
    # the inner_knuckle / inner_finger collision groups, and the per-material / per-mesh
    # MuJoCo tuning. The Mjc* data lives here and not in
    # ./Robotiq_2F_85_newton_common_physics.usda so that layer stays Newton-pure (RV.011).
    #
    # Each Newton variant payload sublayers this (stronger than kinematics) and adds ONLY its
    # distal-coupler delta:
    #   * newton_compliant:     left/right_outer_finger_joint as live revolutes (encompassing grip)
    #   * newton_parallel_grip: left/right_outer_finger_joint suppressed + the outer_finger weld
    #                           (./Robotiq_2F_85_parallel_weld_physics.usda) -> parallel grip
    # Generated by devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # Newton/MuJoCo engine physics on the shared neutral joints: the finger_joint
        # driver, the right_outer_knuckle NewtonMimic, the mjc solver params and the pad
        # springs; Newton closes the four-bar with the loop_closure spherical equalities.
        # left/right_outer_finger_joint is NOT touched here -- its treatment is the
        # per-variant delta.
        over "Joints"
        {
            over "finger_joint" (
                prepend apiSchemas = ["MjcJointAPI", "PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 2.7576203
                float drive:angular:physics:maxForce = 15
                float drive:angular:physics:stiffness = 24.993114
                float drive:angular:physics:targetPosition = 0
                uniform double mjc:armature = 0.3
                uniform double mjc:damping = 0.1
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            over "right_outer_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI", "NewtonMimicAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                uniform double[] mjc:solreflimit = [0.02, 2]
                rel mjc:target = </Robotiq_2F_85/Robotiq_2F_85/Joints/finger_joint>
                rel newton:mimicJoint = </Robotiq_2F_85/Robotiq_2F_85/Joints/finger_joint>
            }

            over "left_inner_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            over "right_inner_knuckle_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solreflimit = [0.02, 2]
            }

            # PhysX four-bar revolutes Newton replaces with the loop_closure spherical
            # equalities (below) -> suppressed. The tree is then base -> outer_knuckle ->
            # outer_finger -> inner_finger (pad) and base -> inner_knuckle, exactly the
            # PhysX body order.
            over "left_inner_finger_knuckle_joint" (active = false) {}
            over "right_inner_finger_knuckle_joint" (active = false) {}

            # The pad joints (outer_finger -> inner_finger), live as on PhysX, carrying the
            # PhysX pad spring (0.0004 N.m/deg = 0.0229 N.m/rad) with springref +/-1.5708
            # rad (90 deg preload, PhysX sign). It holds the pad against the
            # outer_finger_joint 0 deg limit (parallel) until the object pushes it off. The
            # passive loop joints run without joint damping (tuned live).
            over "left_inner_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
                uniform double mjc:springref = 1.5708
                uniform double mjc:stiffness = 0.0229
            }

            over "right_inner_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.02, 2]
                uniform double mjc:springref = -1.5708
                uniform double mjc:stiffness = 0.0229
            }

            # Loop closures at the inner_finger <-> inner_knuckle pin (the PhysX
            # inner_finger_knuckle_joint origin).
            def PhysicsSphericalJoint "right_loop_closure" (
                prepend apiSchemas = ["MjcEqualityConnectAPI"]
            )
            {
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_knuckle>
                uniform bool physics:excludeFromArticulation = 1
                point3f physics:localPos0 = (0, 0.04986, 0.1046)
                point3f physics:localPos1 = (0, 0.04986, 0.1046)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }

            def PhysicsSphericalJoint "left_loop_closure" (
                prepend apiSchemas = ["MjcEqualityConnectAPI"]
            )
            {
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.005, 1]
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_knuckle>
                uniform bool physics:excludeFromArticulation = 1
                point3f physics:localPos0 = (0, -0.04986, 0.1046)
                point3f physics:localPos1 = (0, -0.04986, 0.1046)
                quatf physics:localRot0 = (0, 0, 0, 1)
                quatf physics:localRot1 = (0, 0, 0, 1)
            }
        }

        # MuJoCo pad-material tuning on top of the shared Newton GripMaterial, and the
        # Newton collision groups (the scope is /G/G/Physics, as in newton_common).
        over "Physics"
        {
            # inner_knuckle <-> inner_finger are joined only by the loop_closure equality
            # (no revolute, so MuJoCo does not exclude them as parent/child) and their hulls
            # overlap at the knuckle pin. Newton's USD importer ignores
            # physics:filteredPairs on body prims and the colliders are instance proxies of
            # shared meshes, so the exclusion is done with collision groups: a shape in a
            # positive group only collides with its own group and with the default
            # (negative) group, so two distinct groups never touch each other while both
            # still collide with everything else (objects, the base, the other finger).
            def PhysicsCollisionGroup "InnerKnuckles"
            {
                prepend rel collection:colliders:includes = [
                    </Robotiq_2F_85/Robotiq_2F_85/left_inner_knuckle>,
                    </Robotiq_2F_85/Robotiq_2F_85/right_inner_knuckle>,
                ]
            }

            def PhysicsCollisionGroup "InnerFingers"
            {
                prepend rel collection:colliders:includes = [
                    </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger>,
                    </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger>,
                ]
            }

            over "GripMaterial" (
                prepend apiSchemas = ["MjcMaterialAPI"]
            )
            {
            }
        }
    }
}

# MuJoCo per-mesh solver tuning on top of the shared Newton convex-hull colliders.
over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:condim = 3
                uniform double mjc:gap = 0
                uniform int mjc:group = 2
                uniform double mjc:margin = 0
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double mjc:solmix = 1
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:condim = 3
                uniform double mjc:gap = 0
                uniform int mjc:group = 2
                uniform double mjc:margin = 0
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double mjc:solmix = 1
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 2
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.004, 2]
            }
        }

        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["MjcCollisionAPI"]
            )
            {
                uniform int mjc:group = 3
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }
}
