#usda 1.0
(
    # SensorSim=EffectiveResponse: response r of the pad's contact force and patch (Eq. 1).
    # GENERATED by tools/generate_tactile_zones.py. Layered over Robotiq_2F_85_tactile_zones.usda.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
    )
    {
        float physxArticulation:sleepThreshold = 0

        over "left_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "effectiveResponse"
                custom float2 robotiq:tactile:sigmaMm = (1.5, 1.25)
                custom float robotiq:tactile:eta = 0.7
                custom float robotiq:tactile:gamma = 0.5
            }
        }
        over "right_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "effectiveResponse"
                custom float2 robotiq:tactile:sigmaMm = (1.5, 1.25)
                custom float robotiq:tactile:eta = 0.7
                custom float robotiq:tactile:gamma = 0.5
            }
        }
    }
}
