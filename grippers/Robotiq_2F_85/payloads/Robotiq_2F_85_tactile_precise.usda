            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_fingertip>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_pad_backing>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
