#usda 1.0
(
    # SensorSim=Precise: the deformable TSF-85 pad of the ETS CoRo lab and its CNN (PhysX only).
    # GENERATED by grippers/tactile/generate_tactile_zones.py. Layered over Robotiq_2F_85_tactile_zones.usda.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # The rigid TSF-85 case collider is off: the deformable pad and the backing take its place.
        over "left_fingertip"
        {
            over "visuals" (
                instanceable = false
            )
            {
                over "tip_tsf85"
                {
                    over "TSF_85_case"
                    {
                        bool physics:collisionEnabled = 0
                    }
                }
            }
        }

        # The sensor case: a rigid backing fixed to the fingertip, which the pad is attached to.
        def Xform "left_pad_backing" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.003

            def Cube "collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                double3 xformOp:scale = (0.0284, 0.0213, 0.044)
                double3 xformOp:translate = (0.0, -0.05205, 0.1324)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/left_fingertip>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/left_pad_backing>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        # The rigid TSF-85 case collider is off: the deformable pad and the backing take its place.
        over "right_fingertip"
        {
            over "visuals" (
                instanceable = false
            )
            {
                over "tip_tsf85"
                {
                    over "TSF_85_case"
                    {
                        bool physics:collisionEnabled = 0
                    }
                }
            }
        }

        # The sensor case: a rigid backing fixed to the fingertip, which the pad is attached to.
        def Xform "right_pad_backing" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.003

            def Cube "collider" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double size = 1
                double3 xformOp:scale = (0.0284, 0.0213, 0.044)
                double3 xformOp:translate = (0.0, 0.05205, 0.1324)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            }

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_fingertip>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_pad_backing>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "left_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "precise"
            }
        }
        over "right_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "precise"
            }
        }
    }

    # The deformable pad of the ETS CoRo lab's TSF-85 (parts/TSF_85_pad.usd), in the left inner_finger frame.
    def Xform "left_tsf_pad" (
        prepend references = @../parts/TSF_85_pad.usd@
    )
    {
        double3 xformOp:translate = (0.0142, -0.0628, 0.11042)
        float xformOp:rotateZ = 180
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }

