#usda 1.0
(
    # Physics = "Physx_compliant" payload of the 2F-85: the closed four-bar, so the fingers
    # wrap around an object (encompassing grip) once the pads touch it. Generated by
    # devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_2F_85_physx_common_physics.usda@,
        @./Robotiq_2F_85_collision_physics.usda@,
        @./Robotiq_2F_85_body_mass_physics.usda@,
        @./Robotiq_2F_85_fingertip_physics.usda@,
        @./Robotiq_2F_85_kinematics_physics.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_85" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_85" (
        kind = "assembly"
    )
    {
        # PhysX engine physics on the shared neutral joints. All 10 revolutes are used: the
        # closed four-bar loop is cut at inner_finger_joint (excludeFromArticulation), which
        # carries the weak pad spring (target +-92 deg) that holds the pad parallel until an
        # object pushes it; the right_outer_knuckle mimic stiffness and the finger_joint
        # gains are this variant's (the drive API and mimic wiring are in physx_common); the
        # other passive joints carry zero-gain drives so the loop is free to articulate.
        over "Joints"
        {
            over "finger_joint"
            {
                float drive:angular:physics:damping = 0.0002
                float drive:angular:physics:maxForce = 16.5
                float drive:angular:physics:stiffness = 0.17
            }

            over "right_outer_knuckle_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float physxMimicJoint:rotZ:dampingRatio = 0.01
                float physxMimicJoint:rotZ:naturalFrequency = 5000
            }

            over "right_outer_finger_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
            }

            over "right_inner_finger_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.00001
                float drive:angular:physics:maxForce = 0.5
                float drive:angular:physics:stiffness = 0.0004
                float drive:angular:physics:targetPosition = -92
                uniform bool physics:excludeFromArticulation = 1
            }

            over "right_inner_knuckle_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
                uniform bool physics:excludeFromArticulation = 0
            }

            over "right_inner_finger_knuckle_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
            }

            over "left_outer_finger_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
            }

            over "left_inner_finger_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.00001
                float drive:angular:physics:maxForce = 0.5
                float drive:angular:physics:stiffness = 0.0004
                float drive:angular:physics:targetPosition = 92
                uniform bool physics:excludeFromArticulation = 1
            }

            over "left_inner_knuckle_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
                uniform bool physics:excludeFromArticulation = 0
            }

            over "left_inner_finger_knuckle_joint" (
                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
            }
        }
    }
}
