#usda 1.0
(
    # PhysX-only physics shared by the 2F-85 Physx_parallel_grip and Physx_compliant
    # variants: the PhysX articulation API, the PhysX joint content both grip formulations
    # share, the /Meshes collision-group plumbing, and the PhysX collision schemas on every
    # collider (which meshes collide, as UsdPhysics convex hulls, is the engine-neutral
    # ./Robotiq_2F_85_collision_physics.usda). Everything here carries Physx* schemas, so
    # the Newton variants never sublayer it (RV.011; Isaac's Newton import would read Physx*
    # attributes as a fallback). Nothing here composes under Physics = "None". Generated by
    # devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_85" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_85" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        kind = "assembly"
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        # PhysX joint content identical in both PhysX grip variants, so they cannot drift
        # apart: the finger_joint drive API, zero targets and velocity cap (deg/s), and the
        # right_outer_knuckle mimic wiring. Drive gains, armature and the mimic stiffness
        # stay in each variant payload.
        over "Joints"
        {
            over "finger_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                float physxJoint:maxJointVelocity = 86
            }

            # The right finger follows finger_joint through a PhysX mimic (gearing -1,
            # mirror). Its stiffness (naturalFrequency / dampingRatio) is per variant.
            over "right_outer_knuckle_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
            )
            {
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotZ:gearing = -1
                rel physxMimicJoint:rotZ:referenceJoint = </Robotiq_2F_85/Robotiq_2F_85/Joints/finger_joint>
            }
        }
    }
}

over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    # The /Meshes collision groups keep the shared /Meshes colliders from colliding with the
    # articulation-body copies (each link's instanceable visuals reference /Meshes).
    def PhysicsCollisionGroup "CollisionGroup"
    {
        rel collection:colliders:includes = </Meshes>
        rel physics:filteredGroups
    }

    def PhysicsCollisionGroup "CollisionGroup_01"
    {
        rel collection:colliders:includes = </Robotiq_2F_85>
        rel physics:filteredGroups = </Meshes/CollisionGroup>
    }
}
