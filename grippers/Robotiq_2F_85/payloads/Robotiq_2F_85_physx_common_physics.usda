#usda 1.0
(
    # PhysX-only physics shared by the 2F-85 Physx_parallel_grip and Physx_compliant
    # variants: the articulation root + root_joint (fixed base) and every PhysX
    # convex-hull collider -- the five body-link colliders and the tip collider of each
    # Fingertip variant. Identical across both PhysX grip formulations, so it lives here
    # once and is sublayered by both; the grip-specific content (mimics, outer_finger
    # welds, drive tuning, solver iteration count) stays in each variant payload.
    #
    # Everything here carries Physx* schemas, so Newton variants never sublayer it (RV.011);
    # they author their own Newton colliders in ./Robotiq_2F_85_newton_common_physics.usda.
    # The engine-neutral fingertip bodies/mass/welds live in
    # ./Robotiq_2F_85_fingertip_physics.usda. Only the tip collider of the selected
    # "Fingertip" variant exists in the composed stage; the other tip over is inert.
    # None of this composes under Physics = "None".
    #
    # The /Meshes collision groups are NOT here: the 2F-85 only authors them for
    # parallel_grip (compliant never had them), and moving them would change compliant.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_85" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_85" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        kind = "assembly"
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        # Root/mount joint pinning the gripper base to the world (body0 empty).
        # Makes this a fixed-base articulation, as expected for an End Effector
        # interface asset. When mounting on an arm, retarget or deactivate this joint.
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        # Only present when Fingertip = "Tactile_TSF85" (the tactile payload adds
        # tip_tsf85); this over is inert otherwise. Authored here rather than in the
        # tactile payload so the sensor-case collider never composes under
        # Physics = "None" (which would otherwise leave a world-static actor with no
        # rigid-body ancestor).
        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }
}
