#usda 1.0
(
    # Physics = "Newton_parallel_grip" payload of the 2F-85: the shared Newton four-bar with
    # its distal coupler DOF removed (outer_finger welded to outer_knuckle, its revolutes
    # suppressed), which forces the linkage PARALLEL. outer_finger stays in the articulation
    # (the inner_finger pad joint hangs off it). The closed loop makes this rigid, unlike an
    # open tree coupled by independent mimic constraints. Generated by
    # devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_2F_85_newton_fourbar_physics.usda@,
        @./Robotiq_2F_85_newton_common_physics.usda@,
        @./Robotiq_2F_85_collision_physics.usda@,
        @./Robotiq_2F_85_parallel_weld_physics.usda@,
        @./Robotiq_2F_85_body_mass_physics.usda@,
        @./Robotiq_2F_85_fingertip_physics.usda@,
        @./Robotiq_2F_85_kinematics_physics.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # Parallel: the distal coupler DOF is removed -- outer_finger is welded to
        # outer_knuckle in ./Robotiq_2F_85_parallel_weld_physics.usda, and its revolutes are
        # suppressed.
        over "Joints"
        {
            over "left_outer_finger_joint" (active = false) {}
            over "right_outer_finger_joint" (active = false) {}
        }
    }
}
