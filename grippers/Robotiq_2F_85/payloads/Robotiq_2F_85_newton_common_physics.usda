#usda 1.0
(
    defaultPrim = "Robotiq_2F_85"
    doc = """Shared Newton-pure physics for the Robotiq 2F-85, common to every Newton
grip formulation (newton_compliant, newton_parallel_grip, ...).

Single source of truth for the Newton-tuned values that are identical across those
variants: rigid-body mass / CoM / isotropic diagonal inertia / principalAxes for the
non-shared-mass bodies (outer_finger, inner_finger, inner_knuckle + the outer_knuckle
inertia override), the fingertip bodies + their inner_finger welds, the GripMaterial
pad friction, and the per-mesh convex-hull colliders (+ pad material binding).
Sublayered by each Newton variant payload, which then overlays only its variant- and
engine-specific bits on top:
  * newton_parallel_grip: FixedJoint weld on outer_finger (rigid coupler).
  * newton_compliant: PhysicsFilteredPairsAPI on outer_finger (loop-closure
    self-collision exclusion), and the MuJoCo tuning -- MjcMaterialAPI on GripMaterial,
    MjcCollisionAPI + mjc:* solver params on the mesh colliders.

base_link + left/right_outer_knuckle MASS stay in ./Robotiq_2F_85_body_mass_physics.usda
(shared with the PhysX variants too). This layer is Newton-pure: only UsdPhysics +
Newton* schemas, no Physx*/Mjc* (RV.011); the Mjc tuning lives in the compliant overlay.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # Newton overrides base_link + outer_knuckle inertia (from the shared mass layer)
        # with its intentional isotropic (0.001)^3 solver-stability value.
        over "left_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        over "right_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        # outer_finger mass only; the attachment (parallel weld vs compliant filteredPairs)
        # is added per-variant.
        over "left_outer_finger" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            point3f physics:centerOfMass = (0, -0.065113, 0.074061)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_outer_finger" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            point3f physics:centerOfMass = (0, 0.065113, 0.074061)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_knuckle" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02216
            point3f physics:centerOfMass = (0, -0.031362, 0.082206)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_knuckle" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02216
            point3f physics:centerOfMass = (0, 0.031362, 0.082206)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_finger" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            point3f physics:centerOfMass = (0, -0.057154, 0.110919)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_finger" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02
            point3f physics:centerOfMass = (0, 0.057154, 0.110919)
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        # Fingertips welded to inner_finger (screwed-on pad), Standard-pad mass. Identical
        # across the Newton variants, so the weld lives here (not per-variant).
        over "left_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02598171
            point3f physics:centerOfMass = (0, -0.05063447, 0.12616345)
            float3 physics:diagonalInertia = (0.0000013906384, 0.0000033053761, 0.0000037298817)
            quatf physics:principalAxes = (0.550085, -0.4443045, -0.4443045, 0.550085)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/left_fingertip>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "right_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 0.02598171
            point3f physics:centerOfMass = (0, 0.05063447, 0.12616345)
            float3 physics:diagonalInertia = (0.0000013906384, 0.0000033053761, 0.0000037298817)
            quatf physics:principalAxes = (0.550085, 0.4443045, 0.4443045, 0.550085)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_fingertip>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        # Silicone fingertip pad friction. The compliant overlay adds MjcMaterialAPI.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:staticFriction = 0.7
                float newton:rollingFriction = 0.0001
                float newton:torsionalFriction = 0.005
            }
        }
    }
}

# Convex-hull colliders cooked from the shared visual CAD meshes (over the instanced
# masters). Newton-pure here; the compliant overlay adds MjcCollisionAPI + mjc:* params.
over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }
}
