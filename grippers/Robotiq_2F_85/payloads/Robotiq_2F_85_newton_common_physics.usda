#usda 1.0
(
    defaultPrim = "Robotiq_2F_85"
    doc = """Shared Newton-pure physics for the Robotiq 2F-85, common to every Newton
grip formulation (newton_compliant, newton_parallel_grip, ...).

Single source of truth for the Newton-tuned values that are identical across those
variants: the isotropic diagonal inertia / principalAxes override for the moving
finger-chain links (outer_knuckle, outer_finger, inner_knuckle, inner_finger), the
GripMaterial pad friction, and the per-mesh convex-hull colliders (+ pad material binding).
Sublayered by each Newton variant payload, which then overlays only its variant- and
engine-specific bits on top:
  * newton_parallel_grip: FixedJoint weld on outer_finger (rigid coupler), from the
    shared ./Robotiq_2F_85_parallel_weld_physics.usda.
  * newton_fourbar (both variants): the inner_knuckle / inner_finger collision
    groups, and the MuJoCo tuning -- MjcMaterialAPI on GripMaterial,
    MjcCollisionAPI + mjc:* solver params on the mesh colliders.

Every link's MASS + CoM (and its RigidBody/Mass APIs) comes from
./Robotiq_2F_85_body_mass_physics.usda, and the
fingertip bodies + their inner_finger welds come from ./Robotiq_2F_85_fingertip_physics.usda (both
shared with the PhysX variants too; the Newton variant payloads sublayer them). This layer is Newton-pure: only UsdPhysics +
Newton* schemas, no Physx*/Mjc* (RV.011); the Mjc tuning lives in the fourbar overlay.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # Newton overrides base_link + outer_knuckle inertia (from the shared mass layer)
        # with its intentional isotropic (0.001)^3 solver-stability value.
        over "left_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        over "right_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        # outer_finger / inner_knuckle / inner_finger: mass, CoM and the RigidBody/Mass APIs
        # are inherited from ./Robotiq_2F_85_body_mass_physics.usda (the 2F-85's CAD values,
        # shared with PhysX); Newton overrides only the inertia with the isotropic (0.001)^3
        # solver-stability value (identity principalAxes, overridden together for
        # RB.COL.004). The attachment (parallel weld vs live compliant revolute) is added
        # per-variant.
        over "left_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        # Silicone fingertip pad friction. The fourbar overlay adds MjcMaterialAPI.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:staticFriction = 0.7
                float newton:rollingFriction = 0.0001
                float newton:torsionalFriction = 0.005
            }
        }
    }
}

# Newton collision schemas on the convex-hull colliders cooked from the shared visual CAD
# meshes (over the instanced masters; the neutral collider declaration is
# ./Robotiq_2F_85_collision_physics.usda). Newton-pure here; the fourbar overlay adds MjcCollisionAPI + mjc:* params.
over "Meshes"
{
    over "base_link"
    {
        over "Defeatured_2F_85_PAD_OPEN_basestep_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_basestep" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                float newton:contactGap = 0
            }
        }
    }

    over "inner_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger4step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger4step" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                float newton:contactGap = 0
            }
        }
    }

    over "inner_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger3step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger3step" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                float newton:contactGap = 0
            }
        }
    }

    over "outer_finger"
    {
        over "Defeatured_2F_85_PAD_OPEN_finger2step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_finger2step" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                float newton:contactGap = 0
            }
        }
    }

    over "outer_knuckle"
    {
        over "Defeatured_2F_85_PAD_OPEN_Finger1step_01"
        {
            over "Defeatured_2F_85_PAD_OPEN_Finger1step" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                float newton:contactGap = 0
            }
        }
    }

    over "fingertip"
    {
        over "tip_standard"
        {
            over "Defeatured_2F_85_PAD_OPEN_fingertipsstep" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf85"
        {
            over "TSF_85_case" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_85/Robotiq_2F_85/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }
}
