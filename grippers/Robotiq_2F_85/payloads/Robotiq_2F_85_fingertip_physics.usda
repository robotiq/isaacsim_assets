#usda 1.0
(
    # Engine-neutral fingertip physics for the 2F-85 (UsdPhysics only): the screwed-on
    # fingertip rigid bodies, their PhysicsFixedJoints (welded to inner_finger, rigid like a
    # screw; identity frames, as every link frame is the base frame) and the default
    # "Standard" pad mass/inertia. Sublayered by every Physics variant, so it never composes
    # under Physics = "None".
    #
    # The default pad's mass is authored here (not in the "Fingertip" variantSet) so it is
    # reachable on the configuration/ integration path, which sublayers a variant payload +
    # base.usda but never Robotiq_2F_85.usda. Mass/inertia are the Standard pad's; the
    # "Tactile_TSF85" Fingertip variant overrides them with the sensor-case values in the
    # root layer. The tip colliders are declared in ./Robotiq_2F_85_collision_physics.usda.
    # Generated by devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        over "left_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, -0.05063447, 0.12616345)
            float3 physics:diagonalInertia = (0.0000013906384, 0.0000033053761, 0.0000037298817)
            float physics:mass = 0.02598171
            quatf physics:principalAxes = (0.550085, -0.4443045, -0.4443045, 0.550085)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/left_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "right_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0, 0.05063447, 0.12616345)
            float3 physics:diagonalInertia = (0.0000013906384, 0.0000033053761, 0.0000037298817)
            float physics:mass = 0.02598171
            quatf physics:principalAxes = (0.550085, 0.4443045, 0.4443045, 0.550085)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_85/Robotiq_2F_85/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_85/Robotiq_2F_85/right_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}
