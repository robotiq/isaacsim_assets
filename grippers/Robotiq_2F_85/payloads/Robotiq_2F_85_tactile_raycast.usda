#usda 1.0
(
    # SensorSim=Raycast: depth per taxel from a ray along the pad normal, over a compliant pad.
    # GENERATED by grippers/tactile/generate_tactile_zones.py. Layered over Robotiq_2F_85_tactile_zones.usda.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # A soft pad: the gripped object sinks in proportion to grip force, which the rays read as depth.
        over "Physics"
        {
            over "GripMaterial"
            {
                float physxMaterial:compliantContactStiffness = 20000.0
                float physxMaterial:compliantContactDamping = 120.0
                bool physxMaterial:compliantContactAccelerationSpring = 0
            }
        }

        over "left_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "raycast"
                custom float robotiq:tactile:rayStandoff = 0.02
                custom float robotiq:tactile:rayMaxDistance = 0.06
                custom float robotiq:tactile:padStiffness = 0.429666667
                custom float2 robotiq:tactile:sigmaMm = (1.5, 1.25)
                custom float robotiq:tactile:eta = 0.7
                custom float robotiq:tactile:gamma = 0.5
            }
        }
        over "right_inner_finger"
        {
            over "tactile_zone_visuals"
            {
                custom token robotiq:tactile:method = "raycast"
                custom float robotiq:tactile:rayStandoff = 0.02
                custom float robotiq:tactile:rayMaxDistance = 0.06
                custom float robotiq:tactile:padStiffness = 0.429666667
                custom float2 robotiq:tactile:sigmaMm = (1.5, 1.25)
                custom float robotiq:tactile:eta = 0.7
                custom float robotiq:tactile:gamma = 0.5
            }
        }
    }
}
