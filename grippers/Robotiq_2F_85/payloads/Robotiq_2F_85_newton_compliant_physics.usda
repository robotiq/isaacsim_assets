#usda 1.0
(
    # Physics = "Newton_compliant" payload of the 2F-85: the shared Newton four-bar with its
    # distal coupler DOF kept live -- the left/right_outer_finger_joint revolutes stay
    # active, so the linkage closes by wrapping around the object (encompassing grip).
    # Generated by devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_85"
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_2F_85_newton_fourbar_physics.usda@,
        @./Robotiq_2F_85_newton_common_physics.usda@,
        @./Robotiq_2F_85_collision_physics.usda@,
        @./Robotiq_2F_85_body_mass_physics.usda@,
        @./Robotiq_2F_85_fingertip_physics.usda@,
        @./Robotiq_2F_85_kinematics_physics.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_85"
{
    over "Robotiq_2F_85"
    {
        # Compliant: the distal coupler DOF stays live (MuJoCo tuning only).
        over "Joints"
        {
            over "left_outer_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.00707, 2]
            }

            over "right_outer_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.00707, 2]
            }
        }
    }
}
