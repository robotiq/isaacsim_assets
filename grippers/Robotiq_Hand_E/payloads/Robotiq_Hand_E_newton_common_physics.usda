#usda 1.0
(
    defaultPrim = "Robotiq_Hand_E"
    doc = """Shared Newton-pure physics for the Robotiq Hand-E: the grip-pad friction material
and the per-mesh convex-hull colliders (+ pad material binding on every fingertip).
Sublayered by the Newton variant payload, which adds the Mjc* solver tuning on top (this
layer is Newton-pure: only UsdPhysics + Newton* schemas, no Physx*/Mjc*, RV.011).

Link mass / CoM / inertia come from the shared ./Robotiq_Hand_E_body_mass_physics.usda and the
fingertip bodies + welds from ./Robotiq_Hand_E_fingertip_physics.usda (both engine-neutral, shared with
the PhysX variant), not re-authored here.
GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        # Fingertip pad friction. The Newton variant adds MjcMaterialAPI.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:staticFriction = 0.7
                float newton:rollingFriction = 0.0001
                float newton:torsionalFriction = 0.005
            }
        }
    }
}

# Convex-hull colliders cooked from the shared visual CAD meshes (the baked mesh_0 in /Meshes).
over "Meshes"
{
    over "base_link"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "left_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "right_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    # Tip colliders for every Fingertip variant (derived from TIPS); only the one the
    # Fingertip variant activates composes. Fingertips carry the grip-pad friction material.
    over "fingertip_left"
    {
        over "tip_std"
        {
            over "collision"
            {
                over "hull_0" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
                )
                {
                    uniform token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                    rel material:binding:physics = </Robotiq_Hand_E/Robotiq_Hand_E/Physics/GripMaterial>
                    float newton:contactGap = 0
                }

                over "hull_1" (
