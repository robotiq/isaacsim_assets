#usda 1.0
(
    # Engine-neutral physics deltas of the Stroke100 variant (UsdPhysics only): finger travel 50 mm,
    # the Stroke100 base / finger masses, and the fingertip centres of mass 25 mm further out. Same
    # estimates as the stroke-50 layers (2800 kg/m^3 x baked CAD volume, bounding-box centre, box inertia). Everything
    # else (drives, forces, tip masses) is the stroke-50 value: the datasheet is the same. Sublayered by the Stroke100
    # PhysX / Newton payloads, so it only composes under a Physics variant.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            point3f physics:centerOfMass = (0, 0, 0.048)
            float3 physics:diagonalInertia = (0.00201331367, 0.001242247, 0.00163851667)
            float physics:mass = 0.92528
        }

        over "left_finger"
        {
            point3f physics:centerOfMass = (-0.0141, -0.027, 0.0925)
            float3 physics:diagonalInertia = (1.23558675e-05, 1.0922235e-06, 1.21691862e-05)
            float physics:mass = 0.02853
        }

        # Mirrors left_finger: same mass/inertia, CoM x/y negated.
        over "right_finger"
        {
            point3f physics:centerOfMass = (0.0141, 0.027, 0.0925)
            float3 physics:diagonalInertia = (1.23558675e-05, 1.0922235e-06, 1.21691862e-05)
            float physics:mass = 0.02853
        }

        over "left_fingertip"
        {
            point3f physics:centerOfMass = (-0.0041, -0.0521, 0.1229)
        }

        over "right_fingertip"
        {
            point3f physics:centerOfMass = (0.0041, 0.0521, 0.1229)
        }

        over "Joints"
        {
            over "left_finger_joint"
            {
                float physics:upperLimit = 0.05
            }

            over "right_finger_joint"
            {
                float physics:upperLimit = 0.05
            }
        }
    }
}
