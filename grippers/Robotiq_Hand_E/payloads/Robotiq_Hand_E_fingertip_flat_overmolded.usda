#usda 1.0
(
    # "Flat_Overmolded" fingertip variant: deactivate the default tip and reference the flat rubber overmolded fingertip
    # parts (baked into the Isaac frame at the OUTSIDE hole row). Its collider is authored
    # (inert) in Robotiq_Hand_E_physx_common_physics.usda, so it composes only under a PhysX Physics
    # variant. Tip mass is the shared value from fingertip_physics.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_left"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_flat_overmolded" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_flat_overmolded_left.usd@
        )
        {
            def Xform "collision" (
                prepend references = @../parts/Robotiq_Hand_E_fingertip_flat_overmolded_left_collision.usd@
            )
            {
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_flat_overmolded" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_flat_overmolded_right.usd@
        )
        {
            def Xform "collision" (
                prepend references = @../parts/Robotiq_Hand_E_fingertip_flat_overmolded_right_collision.usd@
            )
            {
            }
        }
    }
}

over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.0491
            }
        }

        over "Joints"
        {
            over "left_finger_joint"
            {
                float drive:linear:physics:maxForce = 260
            }
        }
    }
}
