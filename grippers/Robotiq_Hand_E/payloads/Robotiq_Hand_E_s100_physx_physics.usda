#usda 1.0
(
    # PhysX colliders of the Stroke100 base and fingers (convex hulls of the baked meshes), on top of the Stroke100
    # neutral deltas. Everything else (articulation, drives, mimic, tip colliders) comes from
    # Robotiq_Hand_E_physx_physics.usda, which composes as well.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_Hand_E_s100_neutral_physics.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "base_link"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "left_finger"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "right_finger"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }
}

# base.usda, sublayered above, authors the stroke-50 opening: state the Stroke100 one over it.
over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.1
            }
        }
    }
}
