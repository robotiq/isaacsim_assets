#usda 1.0
(
    # "Bin_Picking" fingertip variant: deactivate the default tip and reference the bin-picking fingertip
    # parts (baked into the Isaac frame at the OUTSIDE hole row). Its collider is authored
    # (inert) in Robotiq_Hand_E_physx_common_physics.usda, so it composes only under a PhysX Physics
    # variant. Tip mass is the shared value from fingertip_physics.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_left"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_binpick" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_left.usd@
        )
        {
        }
    }

    over "fingertip_right"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_binpick" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_right.usd@
        )
        {
        }
    }
}
