#usda 1.0
(
    # "Bin_Picking" fingertip variant: deactivate the default tip and reference the bin-picking fingertip
    # parts (baked into the Isaac frame at the OUTSIDE hole row). Its collider is authored
    # (inert) in Robotiq_Hand_E_physx_common_physics.usda, so it composes only under a PhysX Physics
    # variant. Tip mass is the shared value from fingertip_physics.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_left"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_binpick" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_left.usd@
        )
        {
            def Xform "collision" (
                prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_left_collision.usd@
            )
            {
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_std" (
            active = false
        )
        {
        }

        def Xform "tip_binpick" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_right.usd@
        )
        {
            def Xform "collision" (
                prepend references = @../parts/Robotiq_Hand_E_fingertip_binpick_right_collision.usd@
            )
            {
            }
        }
    }
}

# Drive force cap for this tip: twice the spec-sheet force at the pad (the two fingers share the
# left joint's drive force), see CURVES / DRIVE_TO_PAD in the generator.
over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "Joints"
        {
            over "left_finger_joint"
            {
                float drive:linear:physics:maxForce = 200
            }
        }
    }
}
