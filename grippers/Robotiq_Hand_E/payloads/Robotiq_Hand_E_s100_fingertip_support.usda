#usda 1.0
(
    # "Support" fingertip on the Stroke100 stroke: the grip frame's opening is the stroke-50 one plus
    # 50 mm (each finger 25 mm further out). Everything else about the tip comes from
    # Robotiq_Hand_E_fingertip_support.usda.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.0878
            }
        }
    }
}
