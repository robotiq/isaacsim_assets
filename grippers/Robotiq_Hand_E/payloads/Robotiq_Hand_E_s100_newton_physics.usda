#usda 1.0
(
    defaultPrim = "Robotiq_Hand_E"
    doc = """Newton colliders of the Stroke100 base and fingers: convex hulls of the baked meshes (UsdPhysics + Newton*) plus
the MuJoCo collision tuning of the stroke-50 links (Mjc*), on top of the Stroke100 neutral deltas. Everything else
(articulation, drive, joint equality, tip colliders, pad material) comes from Robotiq_Hand_E_newton_physics.usda, which composes as well.
GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand."""
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_Hand_E_s100_neutral_physics.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "base_link"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MjcCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
                uniform int mjc:condim = 3
                uniform double mjc:gap = 0
                uniform int mjc:group = 2
                uniform double mjc:margin = 0
                uniform int mjc:priority = 1
                uniform double[] mjc:solimp = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double mjc:solmix = 1
                uniform double[] mjc:solref = [0.004, 2]
            }
        }
    }

    over "left_finger"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MjcCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
                uniform int mjc:group = 2
            }
        }
    }

    over "right_finger"
    {
        over "mesh_s100"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MjcCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                float newton:contactGap = 0
                uniform int mjc:group = 2
            }
        }
    }
}

# base.usda, sublayered above, authors the stroke-50 opening: state the Stroke100 one over it.
over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.1
            }
        }
    }
}
