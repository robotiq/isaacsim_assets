#usda 1.0
(
    # "Stroke100" variant: the Hand-E with a 100 mm stroke (50 mm per finger). Its own base and finger bodies
    # (parts/Robotiq_Hand_E_s100_*.usd, baked from the P7L CAD by devel_helpers/gen_hande_s100_parts.py) replace the
    # stroke-50 ones, and the stock fingertips move 25 mm further out along Y. Each stroke-50 link mesh is deactivated and
    # the Stroke100 part added next to it as /Meshes/<link>/mesh_s100; its colliders are authored in the
    # Stroke100 physics layers.
    # GENERATED by devel_helpers/gen_hande_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "base_link"
    {
        over "mesh_0" (
            active = false
        )
        {
        }

        def Xform "mesh_s100" (
            prepend references = @../parts/Robotiq_Hand_E_s100_base.usd@
        )
        {
        }
    }

    over "left_finger"
    {
        over "mesh_0" (
            active = false
        )
        {
        }

        def Xform "mesh_s100" (
            prepend references = @../parts/Robotiq_Hand_E_s100_finger_left.usd@
        )
        {
        }
    }

    over "right_finger"
    {
        over "mesh_0" (
            active = false
        )
        {
        }

        def Xform "mesh_s100" (
            prepend references = @../parts/Robotiq_Hand_E_s100_finger_right.usd@
        )
        {
        }
    }

    # Fingertips: every tip part is baked at the stroke-50 open position; here the fingers are 25 mm
    # further out. This is the tip itself, not the FingertipMount hook (the group's translate), so the Inside
    # offset still adds on top.
    over "fingertip_left"
    {
        over "tip_std"
        {
            double3 xformOp:translate = (0, -0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_flat_overmolded"
        {
            double3 xformOp:translate = (0, -0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_support"
        {
            double3 xformOp:translate = (0, -0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_extender"
        {
            double3 xformOp:translate = (0, -0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_binpick"
        {
            double3 xformOp:translate = (0, -0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    over "fingertip_right"
    {
        over "tip_std"
        {
            double3 xformOp:translate = (0, 0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_flat_overmolded"
        {
            double3 xformOp:translate = (0, 0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_support"
        {
            double3 xformOp:translate = (0, 0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_extender"
        {
            double3 xformOp:translate = (0, 0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        over "tip_binpick"
        {
            double3 xformOp:translate = (0, 0.025, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

over "Robotiq_Hand_E"
{
    over "Robotiq_Hand_E"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.1
            }
        }
    }
}
