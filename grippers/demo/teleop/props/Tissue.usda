    def Mesh "simMesh" (
        apiSchemas = ["OmniPhysicsSurfaceDeformableSimAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "OmniPhysicsDeformablePoseAPI:default"]
    )
    {
        token[] deformablePose:default:omniphysics:purposes = ["bindPose"]
        float physxCollision:contactOffset = 0.003
        float physxCollision:restOffset = 0.001
        uniform token purpose = "guide"
    }

    def Material "TissueMaterial" (
        apiSchemas = ["OmniPhysicsDeformableMaterialAPI", "OmniPhysicsSurfaceDeformableMaterialAPI", "PhysxSurfaceDeformableMaterialAPI"]
    )
    {
        float omniphysics:density = 100
        float omniphysics:dynamicFriction = 1
        float omniphysics:poissonsRatio = 0.3
        float omniphysics:staticFriction = 1
        float omniphysics:surfaceBendStiffness = 0.001
        float omniphysics:surfaceShearStiffness = 0.1
        float omniphysics:surfaceStretchStiffness = 0
        float omniphysics:surfaceThickness = 0.001
        float omniphysics:youngsModulus = 500000
        float physxDeformableMaterial:bendDamping = 0
        float physxDeformableMaterial:elasticityDamping = 0
    }

    def Material "TissueLook"
    {
        token outputs:surface.connect = </Tissue/TissueLook/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.93, 0.92, 0.9)
            float inputs:metallic = 0
            float inputs:roughness = 1
            token outputs:surface
        }
    }
}

