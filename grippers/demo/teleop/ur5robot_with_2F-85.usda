def Xform "World" (
    variants = {
        string Gripper = "physx"
    }
    prepend variantSets = "Gripper"
)
{
    def Scope "Looks"
    {
        def Material "Veneer_UX_Walnut_Cherry"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Veneer_UX_Walnut_Cherry/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Veneer_UX_Walnut_Cherry/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Veneer_UX_Walnut_Cherry/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Plastics/Veneer_UX_Walnut_Cherry.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "Veneer_UX_Walnut_Cherry"
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "Metal_Seamed_Roof"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Metal_Seamed_Roof/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Metal_Seamed_Roof/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Metal_Seamed_Roof/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Metals/Metal_Seamed_Roof.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "Metal_Seamed_Roof"
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "Cloth_Gray"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Cloth_Gray/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Cloth_Gray/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Cloth_Gray/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/Base/Textiles/Cloth_Gray.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "Cloth_Gray"
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

    def Cube "Cube" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.01, -0.01, -0.01), (0.01, 0.01, 0.01)]
        rel material:binding = </World/Looks/Veneer_UX_Walnut_Cherry>
        rel material:binding:physics = </World/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f physics:centerOfMass = (0, 0, 0)
        bool physics:collisionEnabled = 1
        float physics:density = 0
        float3 physics:diagonalInertia = (0, 0, 0)
        bool physics:kinematicEnabled = 0
        float physics:mass = 0.1
        quatf physics:principalAxes = (1, 0, 0, 0)
        bool physics:rigidBodyEnabled = 1
        float physxCollision:contactOffset = 0.002
        float physxCollision:restOffset = 0.0005
        bool physxRigidBody:enableCCD = 0
        bool physxRigidBody:enableSpeculativeCCD = 0
        float physxRigidBody:linearDamping = 0.1
        int physxRigidBody:solverVelocityIterationCount = 4
        double size = 0.02
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.3703595735293894, -0.101588296036721, 0.009946728221864697)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

