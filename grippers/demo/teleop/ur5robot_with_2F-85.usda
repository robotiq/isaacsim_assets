    def "FlatGrid" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Environments/Grid/default_environment.usd@
    )
    {
        over "Environment"
        {
            over "Geometry" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                instanceable = false
            )
            {
                rel material:binding = </World/Looks/Cloth_Gray>
            }
        }
