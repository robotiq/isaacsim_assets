    def OmniGraph "ROS_JointControl"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "OnTick"
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
        }

        def OmniGraphNode "SimTime"
        {
            custom uint64 inputs:referenceTimeDenominator
            custom int64 inputs:referenceTimeNumerator
            custom bool inputs:resetOnStop
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
        }

        def OmniGraphNode "PubClock"
        {
            custom uint64 inputs:context
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_JointControl/OnTick.outputs:tick>
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </World/ROS_JointControl/SimTime.outputs:simulationTime>
            custom string inputs:topicName = "clock"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
            int node:typeVersion = 1
        }

        def OmniGraphNode "SubJointState"
        {
            custom uint64 inputs:context
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_JointControl/OnTick.outputs:tick>
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom string inputs:topicName = "joint_command"
            token node:type = "isaacsim.ros2.bridge.ROS2SubscribeJointState"
            int node:typeVersion = 2
            custom double[] outputs:effortCommand
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom token[] outputs:jointNames
            custom double[] outputs:positionCommand
            custom double outputs:timeStamp
            custom double[] outputs:velocityCommand
        }

        def OmniGraphNode "ArtController"
        {
            custom double[] inputs:effortCommand
            prepend double[] inputs:effortCommand.connect = </World/ROS_JointControl/SubJointState.outputs:effortCommand>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_JointControl/OnTick.outputs:tick>
            custom int[] inputs:jointIndices
            custom token[] inputs:jointNames
            prepend token[] inputs:jointNames.connect = </World/ROS_JointControl/SubJointState.outputs:jointNames>
            custom double[] inputs:positionCommand
            prepend double[] inputs:positionCommand.connect = </World/ROS_JointControl/SubJointState.outputs:positionCommand>
            custom string inputs:robotPath
            custom rel inputs:targetPrim = </World/ur5e/root_joint> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom double[] inputs:velocityCommand
            prepend double[] inputs:velocityCommand.connect = </World/ROS_JointControl/SubJointState.outputs:velocityCommand>
            token node:type = "isaacsim.core.nodes.IsaacArticulationController"
            int node:typeVersion = 1
        }

        def OmniGraphNode "ReadJointState"
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_JointControl/OnTick.outputs:tick>
            custom rel inputs:prim = </World/ur5e/root_joint> (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            token node:type = "isaacsim.sensors.physics.IsaacReadJointState"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            custom uchar[] outputs:jointDofTypes
            custom double[] outputs:jointEfforts
            custom token[] outputs:jointNames
            custom double[] outputs:jointPositions
            custom double[] outputs:jointVelocities
            custom float outputs:sensorTime
            custom float outputs:stageMetersPerUnit
        }

        def OmniGraphNode "PubJointState"
        {
            custom uint64 inputs:context
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </World/ROS_JointControl/ReadJointState.outputs:execOut>
            custom uchar[] inputs:jointDofTypes
            prepend uchar[] inputs:jointDofTypes.connect = </World/ROS_JointControl/ReadJointState.outputs:jointDofTypes>
            custom double[] inputs:jointEfforts
            prepend double[] inputs:jointEfforts.connect = </World/ROS_JointControl/ReadJointState.outputs:jointEfforts>
            custom token[] inputs:jointNames
            prepend token[] inputs:jointNames.connect = </World/ROS_JointControl/ReadJointState.outputs:jointNames>
            custom double[] inputs:jointPositions
            prepend double[] inputs:jointPositions.connect = </World/ROS_JointControl/ReadJointState.outputs:jointPositions>
            custom double[] inputs:jointVelocities
            prepend double[] inputs:jointVelocities.connect = </World/ROS_JointControl/ReadJointState.outputs:jointVelocities>
            custom string inputs:nodeNamespace
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom float inputs:sensorTime
            prepend float inputs:sensorTime.connect = </World/ROS_JointControl/ReadJointState.outputs:sensorTime>
            custom float inputs:stageMetersPerUnit
            prepend float inputs:stageMetersPerUnit.connect = </World/ROS_JointControl/ReadJointState.outputs:stageMetersPerUnit>
            custom rel inputs:targetPrim (
                customData = {
                    dictionary omni = {
                        dictionary graph = {
                            string relType = "target"
                        }
                    }
                }
            )
            custom double inputs:timeStamp
            prepend double inputs:timeStamp.connect = </World/ROS_JointControl/SimTime.outputs:simulationTime>
            custom string inputs:topicName = "joint_states"
            token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
            int node:typeVersion = 1
        }
    }

    def Cylinder "Cylinder" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "PhysxCollisionAPI", "PhysxRigidBodyAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        float3[] extent = [(-0.025, -0.025, -0.05), (0.025, 0.025, 0.05)]
        double height = 0.1
        rel material:binding = </World/Looks/Metal_Seamed_Roof>
        rel material:binding:physics = </World/PhysicsMaterial>
        point3f physics:centerOfMass = (0, 0, 0)
        float physics:density = 0
        float3 physics:diagonalInertia = (0, 0, 0)
        float physics:mass = 0.1
        quatf physics:principalAxes = (1, 0, 0, 0)
        float physxCollision:contactOffset = 0.002
        float physxCollision:restOffset = 0.0005
        float physxRigidBody:angularDamping = 0.05
        bool physxRigidBody:enableCCD = 0
        bool physxRigidBody:enableSpeculativeCCD = 0
        float physxRigidBody:linearDamping = 0.1
        float physxRigidBody:sleepThreshold = 0.00005
        int physxRigidBody:solverPositionIterationCount = 16
        int physxRigidBody:solverVelocityIterationCount = 4
        float physxRigidBody:stabilizationThreshold = 0.00001
        double radius = 0.025
        custom bool refinementEnableOverride = 1
        custom int refinementLevel = 2
        quatd xformOp:orient = (0.7071067811865476, 0.7071067811865475, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.2538029387070952, 0, 0.024002205408456715)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    variantSet "Gripper" = {
        "newton" {
            over "ur5e"
            {
                over "wrist_3_link"
                {
                    def "Robotiq_2F_85_edit" (
                        prepend payload = @../../Robotiq_2F_85/Robotiq_2F_85.usda@
                        variants = {
                            string Physics = "Newton_compliant"
                        }
                    )
                    {
                        quatf xformOp:orient = (1, 0, 0, 0)
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                        over "Robotiq_2F_85" (
                            delete apiSchemas = ["PhysicsArticulationRootAPI"]
                        )
                        {
                            # Mounted on the arm wrist by the FixedJoint below, so
                            # deactivate the asset's world-pinning root_joint (same as
                            # the physx variant) to avoid double-constraining base_link.
                            over "root_joint" (
                                active = false
                            )
                            {
                            }
                        }
                    }
                }

                over "joints"
                {
                    over "shoulder_pan_joint"
                    {
                        float drive:angular:physics:damping = 940.0501
                        uniform double mjc:armature = 1
                    }

                    over "shoulder_lift_joint"
                    {
                        float drive:angular:physics:damping = 1002.092
                        uniform double mjc:armature = 1
                    }

                    over "elbow_joint"
                    {
                        float drive:angular:physics:damping = 1023.0221
                        uniform double mjc:armature = 1
                    }

                    over "wrist_1_joint"
                    {
                        float drive:angular:physics:damping = 394.0629
                        uniform double mjc:armature = 0.3
                    }

                    over "wrist_2_joint"
                    {
                        float drive:angular:physics:damping = 394.0629
                        uniform double mjc:armature = 0.3
                    }

                    over "wrist_3_joint"
                    {
                        float drive:angular:physics:damping = 100.00809
                        uniform double mjc:armature = 0.3
                    }
                }
            }

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </World/ur5e/wrist_3_link>
                rel physics:body1 = </World/ur5e/wrist_3_link/Robotiq_2F_85_edit/Robotiq_2F_85/base_link>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (-0.3129819, 0.27369457, 0.19359241)
                point3f physics:localPos1 = (-0.3129819, 0.27369457, 0.19359241)
                quatf physics:localRot0 = (0.008417077, 0.87681663, -0.47042993, 0.09908279)
                quatf physics:localRot1 = (0.008417077, 0.87681663, -0.47042993, 0.09908279)
            }

        }
        "physx" {
            over "ur5e"
            {
                over "wrist_3_link"
                {
                    def "Robotiq_2F_85_edit" (
                        prepend payload = @../../Robotiq_2F_85/Robotiq_2F_85.usda@
                        variants = {
                            string Physics = "Physx_compliant"
                        }
                    )
                    {
                        string isaac:namespace (
                            displayName = "Namespace"
                            doc = "Namespace of the prim in Isaac Sim"
                        )
                        quatf xformOp:orient = (1, 0, 0, 0)
                        float3 xformOp:scale = (1, 1, 1)
                        double3 xformOp:translate = (0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                        over "Robotiq_2F_85" (
                            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
                        )
                        {
                            # Gripper is mounted on the UR5e wrist (gripper_mount joint
                            # below), so deactivate the asset's world-pinning root_joint
                            # to avoid double-constraining base_link.
                            over "root_joint" (
                                active = false
                            )
                            {
                            }

                            over "base_link"
                            {
                                string isaac:nameOverride (
                                    displayName = "Name Override"
                                )
                                rel physics:simulationOwner
                            }

                            over "left_outer_knuckle"
                            {
                                rel physics:simulationOwner
                            }

                            over "left_outer_finger" (
                                prepend apiSchemas = ["PhysxRigidBodyAPI"]
                            )
                            {
                                rel physics:simulationOwner
                                int physxRigidBody:solverPositionIterationCount = 64
                                int physxRigidBody:solverVelocityIterationCount = 8
                            }

                            over "left_inner_finger" (
                                prepend apiSchemas = ["PhysxRigidBodyAPI"]
                            )
                            {
                                rel physics:simulationOwner
                                int physxRigidBody:solverPositionIterationCount = 64
                                int physxRigidBody:solverVelocityIterationCount = 8
                            }

                            over "left_inner_knuckle"
                            {
                                rel physics:simulationOwner
                            }

                            over "right_outer_knuckle"
                            {
                                rel physics:simulationOwner
                            }

                            over "right_outer_finger" (
                                prepend apiSchemas = ["PhysxRigidBodyAPI"]
                            )
                            {
                                rel physics:simulationOwner
                                int physxRigidBody:solverPositionIterationCount = 64
                                int physxRigidBody:solverVelocityIterationCount = 8
                            }

                            over "right_inner_finger" (
                                prepend apiSchemas = ["PhysxRigidBodyAPI"]
                            )
                            {
                                rel physics:simulationOwner
                                int physxRigidBody:solverPositionIterationCount = 64
                                int physxRigidBody:solverVelocityIterationCount = 8
                            }

                            over "right_inner_knuckle"
                            {
                                rel physics:simulationOwner
                            }

                            over "Joints"
                            {
                                over "finger_joint"
                                {
                                    float drive:angular:physics:damping = 3
                                    float drive:angular:physics:maxForce = 1
                                    float drive:angular:physics:stiffness = 50
                                    float drive:angular:physics:targetPosition = 0
                                    bool[] isaac:actuator (
                                        displayName = "Actuator"
                                    )
                                    string isaac:NameOverride (
                                        displayName = "Joint Name Override"
                                    )
                                    token[] isaac:physics:DofOffsetOpOrder (
                                        displayName = "Dof Offset Op Order"
                                    )
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }

                                over "right_outer_knuckle_joint"
                                {
                                    bool[] isaac:actuator (
                                        displayName = "Actuator"
                                    )
                                    string isaac:NameOverride (
                                        displayName = "Joint Name Override"
                                    )
                                    token[] isaac:physics:DofOffsetOpOrder (
                                        displayName = "Dof Offset Op Order"
                                    )
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }

                                over "left_inner_finger_knuckle_joint"
                                {
                                    bool[] isaac:actuator (
                                        displayName = "Actuator"
                                    )
                                    string isaac:NameOverride (
                                        displayName = "Joint Name Override"
                                    )
                                    token[] isaac:physics:DofOffsetOpOrder (
                                        displayName = "Dof Offset Op Order"
                                    )
                                    uniform bool physics:excludeFromArticulation = 0
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }

                                over "right_inner_finger_knuckle_joint"
                                {
                                    bool[] isaac:actuator (
                                        displayName = "Actuator"
                                    )
                                    string isaac:NameOverride (
                                        displayName = "Joint Name Override"
                                    )
                                    token[] isaac:physics:DofOffsetOpOrder (
                                        displayName = "Dof Offset Op Order"
                                    )
                                    uniform bool physics:excludeFromArticulation = 0
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }

                                over "left_outer_finger_joint"
                                {
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }

                                over "right_outer_finger_joint"
                                {
                                    uniform bool physics:excludeFromArticulation = 0
                                    float physics:lowerLimit = -45
                                    float physics:upperLimit = 0
                                    float state:angular:physics:position = 0
                                    float state:angular:physics:velocity = 0
                                }
                            }
                        }
                    }
                }
            }

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </World/ur5e/wrist_3_link>
                rel physics:body1 = </World/ur5e/wrist_3_link/Robotiq_2F_85_edit/Robotiq_2F_85/base_link>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (-0.3129819, 0.27369457, 0.19359241)
                point3f physics:localPos1 = (-0.3129819, 0.27369457, 0.19359241)
                quatf physics:localRot0 = (0.008417077, 0.87681663, -0.47042993, 0.09908279)
                quatf physics:localRot1 = (0.008417077, 0.87681663, -0.47042993, 0.09908279)
            }

        }
    }
}

def "Render" (
    hide_in_stage_window = true
    no_delete = true
)
{
    def "OmniverseKit"
    {
        def "HydraTextures" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </OmniverseKit_Persp>
                token omni:rtx:ambientOcclusion:denoiserMode = "none"
                token omni:rtx:background:source:texture:textureMode = "repeatMirrored"
                token omni:rtx:background:source:type = "domeLight"
                bool omni:rtx:debug:view:pixelDebug:enableFixedTextPos = 1
                token omni:rtx:directLighting:sampledLighting:denoisingTechnique = "None"
                bool omni:rtx:dlss:frameGeneration = 0
                float3 omni:rtx:domeLight:rotationAxis = (0, 0, 1)
                bool omni:rtx:indirectDiffuse:denoiser:enabled = 0
                bool omni:rtx:material:db:syncLoads = 1
                token omni:rtx:post:dlss:execMode = "performance"
                bool omni:rtx:post:registeredCompositing:invertColorCorrection = 1
                bool omni:rtx:post:registeredCompositing:invertToneMap = 1
                bool omni:rtx:pt:adaptiveSampling:filterError = 0
                uint omni:rtx:pt:adaptiveSampling:fixedSppIterations = 2
                float omni:rtx:pt:fireflyFilter:maxPerEmissiveUnexposedIntensity = 3199.9995
                float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSample = 3199.9995
                float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSampleDiffuse = 3199.9995
                uint omni:rtx:pt:maxSamplesPerLaunch = 2073600
                uint omni:rtx:pt:mgpu:maxPixelsPerRegionExponent = 12
                bool omni:rtx:reflections:denoiser:enabled = 0
                token omni:rtx:rendermode = "MinimalRendering"
                color3f omni:rtx:rt:ambientLight:color = (0.1, 0.1, 0.1)
                bool omni:rtx:rt:demoire = 0
                float omni:rtx:rt:directLighting:maxRayUnexposedIntensity = 6399.999
                bool omni:rtx:rt:ecoMode:enabled
                float omni:rtx:rt:indirectdiffuse:maxRayUnexposedIntensity = 6399.999
                float omni:rtx:rt:inscattering:maxRTSampleUnexposedIntensity = 204799.97
                bool omni:rtx:rt:lightcache:spatialCache:dontResolveConflicts = 1
                float omni:rtx:rt:refractions:maxRayUnexposedIntensity = 19199.998
                int omni:rtx:rt:sss:samples = 1
                uint omni:rtx:rtpt:maxVolumeBounces = 15
                float omni:rtx:rtpt:modulatingRoughnessThreshold = 0.08
                bool omni:rtx:scene:hydra:materialSyncLoads = 1
                bool omni:rtx:scene:hydra:mdlMaterialWarmup = 1
                bool omni:rtx:scene:useViewLightingMode = 1
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 720)
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>
    }

    def "Vars"
    {
        def RenderVar "LdrColor" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            uniform string sourceName = "LdrColor"
            uniform token sourceType = "raw"
        }
    }
}

