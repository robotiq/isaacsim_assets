# Grant the logged-in seat user access to the DualSense hidraw node.
#
# WHY: trigger_force_feedback.py drives R2 trigger resistance through
# pydualsense, which talks to the controller over /dev/hidraw*. Unlike
# /dev/input/js0 (which systemd-logind ACLs to the active seat automatically),
# hidraw nodes are root-only by default, so pydualsense fails with:
#
#     OSError: Could not open connection to device.
#
# TAG+="uaccess" makes logind apply the same seat ACL it gives js0.
#
# Covers both transports: USB (054c:0ce6) and Bluetooth.
#
# INSTALL:
#   sudo cp ~/70-dualsense-hidraw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger --subsystem-match=hidraw
#   # then unplug/replug the controller
#
# VERIFY:  getfacl /dev/hidraw0   # should show user:<you>:rw-

# DualSense over USB
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"

# DualSense over Bluetooth (no idVendor/idProduct on the parent; match the HID uniq)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"

# DualSense Edge, in case one shows up later
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
