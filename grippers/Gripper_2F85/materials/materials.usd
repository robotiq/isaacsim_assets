        def Material "Nobel"
        {
            token outputs:mdl:displacement.connect = </World/Looks/Nobel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/Nobel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/Nobel/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.7019608, 0.7019608, 0.7019608)
                color3f inputs:emissive_color = (0, 0, 0)
                float inputs:emissive_intensity = 0
                bool inputs:enable_emission = 0
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.5
                token outputs:out
            }
        }

