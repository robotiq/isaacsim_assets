#usda 1.0
(
    # PhysX variant of the Hand-E C10: finger_1_joint is the single driven DOF (linear position drive); finger_2_joint and
    # finger_3_joint mimic it (rigid, gearing -1 as on the Hand-E: every joint frame points inward, so all three close
    # with +position). Shared neutral joint frames/limits live in ./Robotiq_Hand_E_C10_kinematics_physics.usda (sublayered below).
    #
    # Drive: maxJointVelocity 0.0535 m/s per finger (half the datasheet's closing speed of 14 to 107 mm/s, read as the
    # diameter's). maxForce 525 N = 3 x the datasheet's 175 N per finger, because the three
    # fingers share the driven joint's force. Stiffness 100000 N/m reaches the cap from 5.25 mm of remaining stroke (objects wider than 12.5 mm; a narrower one gets less), damping 283.
    # GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E_C10"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./Robotiq_Hand_E_C10_physx_common_physics.usda@,
        @./Robotiq_Hand_E_C10_kinematics_physics.usda@,
        @./Robotiq_Hand_E_C10_body_mass_physics.usda@,
        @./Robotiq_Hand_E_C10_fingertip_physics.usda@
    ]
)

def Xform "Robotiq_Hand_E_C10" (
    kind = "assembly"
)
{
    over Xform "Robotiq_Hand_E_C10" (
        kind = "assembly"
    )
    {
        int physxArticulation:solverPositionIterationCount = 64

        over "Joints"
        {
            over "finger_1_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 283
                float drive:linear:physics:maxForce = 525
                float drive:linear:physics:stiffness = 100000
                float drive:linear:physics:targetPosition = 0
                float drive:linear:physics:targetVelocity = 0
                float physxJoint:armature = 0.001
                float physxJoint:maxJointVelocity = 0.0535
            }

            over "finger_2_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float physxJoint:armature = 0.001
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = -1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/Joints/finger_1_joint>
            }

            over "finger_3_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float physxJoint:armature = 0.001
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = -1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/Joints/finger_1_joint>
            }
        }
    }
}
