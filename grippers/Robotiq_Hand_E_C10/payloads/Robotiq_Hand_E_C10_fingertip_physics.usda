            {
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_3>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/fingertip_3>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
