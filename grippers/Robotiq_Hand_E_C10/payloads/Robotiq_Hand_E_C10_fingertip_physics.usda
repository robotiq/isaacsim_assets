#usda 1.0
(
    # Engine-neutral fingertip physics for the Hand-E C10 (UsdPhysics only): the screwed-on fingertip rigid bodies and
    # their PhysicsFixedJoints (welded to the finger stub, rigid like a screw). Sublayered by every Physics variant.
    #
    # Mass is 30.7 g per tip (aluminium 2700 kg/m^3 x CAD volume); centre of mass and moments from the baked mesh.
    # With the Flipped variant the tip is the same body turned upside down about the pad's middle (same mass, moved centre of mass).
    # With the Extender variant the body is the tip moved onto the extender plus the extender (60.1 g: the manual's +180.2 g for
    # the three extenders with their screws): 90.7 g.
    # This layer only composes under a Physics variant, never under Physics = "None".
    # GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E_C10"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_Hand_E_C10" (
    prepend variantSets = ["Fingertip"]
)
{
    # The mass properties depend on the Fingertip variant (the Extender variant adds the extenders to each tip body), and a
    # local opinion would beat a variant one, so the two sets of values are both authored in variants.
    variantSet "Fingertip" = {
        "Stepped" {
            over "Robotiq_Hand_E_C10"
            {
        over "fingertip_1"
        {
            point3f physics:centerOfMass = (0.0513272931, 5.02096408e-07, 0.127897517)
            float3 physics:diagonalInertia = (2.49551989e-06, 6.22787911e-06, 7.40338649e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (0.668210035, 0.668221471, -0.231266382, 0.231281808)
        }
        over "fingertip_2"
        {
            point3f physics:centerOfMass = (-0.0256755141, 0.044458485, 0.127897518)
            float3 physics:diagonalInertia = (2.49551988e-06, 6.22787938e-06, 7.4033867e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (0.463063597, 0.694327757, -0.1338091, -0.534393297)
        }
        over "fingertip_3"
        {
            point3f physics:centerOfMass = (-0.0256758527, -0.0444568941, 0.127897518)
            float3 physics:diagonalInertia = (2.49551994e-06, 6.22787937e-06, 7.40338669e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (0.69432996, 0.463045962, 0.53440094, 0.13382817)
        }
            }
        }
        "Extender" {
            over "Robotiq_Hand_E_C10"
            {
        over "fingertip_1"
        {
            point3f physics:centerOfMass = (0.0722766633, 7.97094268e-07, 0.124130614)
            float3 physics:diagonalInertia = (8.97270045e-06, 5.16472162e-05, 5.77819579e-05)
            float physics:mass = 0.0907344968
            quatf physics:principalAxes = (0.701850874, -0.70183204, -0.0861317392, -0.0861304926)
        }
        over "fingertip_2"
        {
            point3f physics:centerOfMass = (-0.0361428857, 0.0625957308, 0.124130614)
            float3 physics:diagonalInertia = (8.97126207e-06, 5.16606796e-05, 5.77939823e-05)
            float physics:mass = 0.0907344968
            quatf physics:principalAxes = (0.650952235, -0.564684857, 0.425471745, -0.276343979)
        }
        over "fingertip_3"
        {
            point3f physics:centerOfMass = (-0.0361419134, -0.0625958212, 0.124130614)
            float3 physics:diagonalInertia = (8.97140066e-06, 5.16593918e-05, 5.77928326e-05)
            float physics:mass = 0.0907344968
            quatf physics:principalAxes = (0.650995238, 0.564645595, 0.425443883, 0.276365798)
        }
            }
        }
        "Flipped" {
            over "Robotiq_Hand_E_C10"
            {
        over "fingertip_1"
        {
            point3f physics:centerOfMass = (0.0513272931, -5.02096408e-07, 0.108702483)
            float3 physics:diagonalInertia = (2.49551989e-06, 6.22787911e-06, 7.40338649e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (0.668221471, -0.668210035, 0.231281808, 0.231266382)
        }
        over "fingertip_2"
        {
            point3f physics:centerOfMass = (-0.0256644204, 0.04446489, 0.108702482)
            float3 physics:diagonalInertia = (2.49551988e-06, 6.22787938e-06, 7.4033867e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (-0.463045958, 0.694329969, -0.13382819, 0.534400926)
        }
        over "fingertip_3"
        {
            point3f physics:centerOfMass = (-0.0256628733, -0.0444643878, 0.108702482)
            float3 physics:diagonalInertia = (2.49551994e-06, 6.22787937e-06, 7.40338669e-06)
            float physics:mass = 0.0306611635
            quatf physics:principalAxes = (0.694327771, -0.463063575, -0.534393299, 0.133809096)
        }
            }
        }
    }

    over "Robotiq_Hand_E_C10"
    {
        over "fingertip_1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_1>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/fingertip_1>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "fingertip_2" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_2>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/fingertip_2>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
