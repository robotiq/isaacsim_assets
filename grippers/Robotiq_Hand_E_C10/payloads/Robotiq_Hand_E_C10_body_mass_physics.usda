#usda 1.0
(
    # Shared rigid-body mass for the four Hand-E C10 body links (base + three sliding finger stubs). Engine-neutral
    # (UsdPhysics only), sublayered by the PhysX and Newton variants.
    #
    # Every body link carries its collider in the shared invisible /Meshes scope, so PhysX cannot auto-compute mass:
    # it is authored explicitly, from the baked CAD meshes. A finger stub (the slider and its two tip screws) is
    # 16.1 g (aluminium 2700 kg/m^3, steel screws 7850 kg/m^3); the base takes the rest of the
    # datasheet weight (1.7 kg). The defeatured CAD has no motor inside, so the base mass is spread over the visible solids and
    # its real centre of mass is probably deeper. Centre of mass and the principal moments come from the closed meshes.
    # GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E_C10"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_Hand_E_C10"
{
    over "Robotiq_Hand_E_C10"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-9.81887855e-05, 0.000732631415, 0.0659795399)
            float3 physics:diagonalInertia = (0.00173372523, 0.00283872512, 0.00286011943)
            float physics:mass = 1.5596988
            quatf physics:principalAxes = (0.4182349, 0.570700416, -0.417132326, 0.570421972)
        }

        over "finger_1" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.0363738436, -6.3502725e-05, 0.107154396)
            float3 physics:diagonalInertia = (6.0996074e-07, 1.21641241e-06, 1.4526257e-06)
            float physics:mass = 0.0161059021
            quatf physics:principalAxes = (0.711547137, -0.701950552, -0.0190086995, 0.0245919608)
        }

        over "finger_2" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.0181433591, 0.03154042, 0.107154396)
            float3 physics:diagonalInertia = (6.09960754e-07, 1.21641241e-06, 1.4526257e-06)
            float physics:mass = 0.0161059021
            quatf physics:principalAxes = (0.334513288, 0.334476274, 0.628513858, 0.61741138)
        }

        over "finger_3" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (-0.0182545572, -0.0314748242, 0.107154396)
            float3 physics:diagonalInertia = (6.09960734e-07, 1.21641243e-06, 1.45262575e-06)
            float physics:mass = 0.0161059021
            quatf physics:principalAxes = (0.603921901, 0.598402661, 0.367437298, 0.377070848)
        }
    }
}
