#usda 1.0
(
    defaultPrim = "Robotiq_Hand_E_C10"
    doc = """Shared, engine-NEUTRAL kinematic tree for the Robotiq Hand-E C10.

Three prismatic joints (base_link -> finger_1 / finger_2 / finger_3), each with a 19.2 mm stroke. The fingers
sit 120 degrees apart about the gripper axis (Z), finger 1 along +X. Link frames are identity/world, so a joint's
frame is its own turn about Z: its +X axis points toward the gripper axis, so closing is +position on all three joints
and the mimic coupling is a plain gearing.

Neutrality rule (SimReady RV.011): only UsdPhysics + PhysicsJointStateAPI here -- no
Physx*/Mjc*/Newton* schemas, no drives/mimics/armature.
GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robotiq_Hand_E_C10"
{
    def Xform "Robotiq_Hand_E_C10"
    {
        def Scope "Joints"
        {
            def PhysicsPrismaticJoint "finger_1_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                uniform token physics:axis = "X"
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/base_link>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_1>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (6.123234e-17, 0, 0, 1)
                quatf physics:localRot1 = (6.123234e-17, 0, 0, 1)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.0192
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "finger_2_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                uniform token physics:axis = "X"
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/base_link>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_2>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (-0.866025404, 0, 0, 0.5)
                quatf physics:localRot1 = (-0.866025404, 0, 0, 0.5)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.0192
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "finger_3_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                uniform token physics:axis = "X"
                rel physics:body0 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/base_link>
                rel physics:body1 = </Robotiq_Hand_E_C10/Robotiq_Hand_E_C10/finger_3>
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (-0.866025404, 0, 0, -0.5)
                quatf physics:localRot1 = (-0.866025404, 0, 0, -0.5)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.0192
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
            }
        }
    }
}
