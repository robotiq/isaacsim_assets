#usda 1.0
(
    # "Flipped" fingertip variant: the default tip turned upside down (180 degrees about the finger's radial axis through the
    # middle of the pad, z 118.3 mm), so the pad stays where it is and the step and post point toward the flange. No new
    # part: the stepped tip's mesh and colliders are reused and only its transform changes. The mass properties of the fingertip
    # bodies are authored per Fingertip variant in Robotiq_Hand_E_C10_fingertip_physics.usda.
    # GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E_C10"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_1"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (0, 0, 0.2366)
            quatd xformOp:orient = (0, 1, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "fingertip_2"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (0, 0, 0.2366)
            quatd xformOp:orient = (0, -0.5, 0.866025404, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "fingertip_3"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (0, 0, 0.2366)
            quatd xformOp:orient = (0, -0.5, -0.866025404, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
}
