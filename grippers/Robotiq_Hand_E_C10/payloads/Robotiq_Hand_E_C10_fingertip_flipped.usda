#usda 1.0
(
    # "Flipped" fingertip variant: the default tip turned 180 degrees about the vertical (Z) axis through the middle of its
    # footprint (x 44.7 mm on finger 1), so it sits on the same spot and its outer back faces the axis. No new
    # part: the stepped tip's mesh and colliders are reused and only its transform changes. The mass properties of the fingertip
    # bodies are authored per Fingertip variant in Robotiq_Hand_E_C10_fingertip_physics.usda.
    # GENERATED by devel_helpers/gen_hande_c10_layers.py -- do not edit by hand.
    defaultPrim = "Robotiq_Hand_E_C10"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_1"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (0.0894, 0, 0)
            quatd xformOp:orient = (0, 0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "fingertip_2"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (-0.0447, 0.0774226711, 0)
            quatd xformOp:orient = (0, 0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    over "fingertip_3"
    {
        over "tip_stepped"
        {
            double3 xformOp:translate = (-0.0447, -0.0774226711, 0)
            quatd xformOp:orient = (0, 0, 0, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }
}
