#usda 1.0
(
    # PhysX "parallel grip" variant of the 2F-140. Mirrors OUR 2F-85
    # Physx_parallel_grip payload structure exactly: the shared neutral joint
    # frames/limits/bodies live in ./Robotiq_2F_140_kinematics_physics.usda
    # (sublayered below); this layer OVERLAYS only the PhysX engine physics --
    # the finger_joint driver + armature and the mimic coupling that ties the
    # passive joints to it -- suppresses the compliant four-bar's unused revolutes
    # (active=false), and welds outer_knuckle<->outer_finger rigid. Drive gains,
    # mimic axes (rotZ/rotX) and gearings are the 85's; only the joint positions
    # (in the kinematics layer) and the driven range are the 2F-140's.
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./Robotiq_2F_140_kinematics_physics.usda@,
        @./Robotiq_2F_140_body_mass_physics.usda@,
        @./Robotiq_2F_140_fingertip_physics.usda@
    ]
)

def Xform "Robotiq_2F_140" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_140" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        kind = "assembly"
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        int physxArticulation:solverPositionIterationCount = 64

        # Root/mount joint pinning the gripper base to the world (fixed base).
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        # Engine overlay on the shared neutral joints. finger_joint is the single
        # driven DOF; the rest of the four-bar is reproduced with mimic joints (no
        # closed loop). The compliant four-bar's outer_finger / inner_knuckle
        # revolutes are not used here -> suppressed (active=false); the
        # outer_knuckle<->outer_finger link is a rigid FixedJoint weld (below).
        over "Joints"
        {
            over "finger_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.0002
                float drive:angular:physics:maxForce = 26
                float drive:angular:physics:stiffness = 3
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                float physxJoint:armature = 0.0001
                float physxJoint:maxJointVelocity = 146.46
            }

            over "right_outer_knuckle_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float physxJoint:armature = 0.0001
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotZ:dampingRatio = 0
                float physxMimicJoint:rotZ:gearing = -1
                float physxMimicJoint:rotZ:naturalFrequency = 0
                rel physxMimicJoint:rotZ:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }

            over "right_inner_finger_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = 1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }

            over "right_inner_finger_knuckle_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = -1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }

            over "left_inner_finger_knuckle_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:stiffness = 0
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = 1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }

            over "left_inner_finger_joint" (
                delete apiSchemas = ["PhysicsDriveAPI:angular"]
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotX"]
            )
            {
                float drive:angular:physics:damping = 0
                float drive:angular:physics:maxForce = 0
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetPosition = 0
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotX:dampingRatio = 0
                float physxMimicJoint:rotX:gearing = -1
                float physxMimicJoint:rotX:naturalFrequency = 0
                rel physxMimicJoint:rotX:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }

            # Compliant four-bar joints the open-tree parallel grip does not use.
            over "left_outer_finger_joint" (active = false) {}
            over "right_outer_finger_joint" (active = false) {}
            over "left_inner_knuckle_joint" (active = false) {}
            over "right_inner_knuckle_joint" (active = false) {}
        }

        # Outer knuckle -> outer finger is rigid (URDF outer_finger_joint is fixed).
        # Both link frames are identity/world, so the weld uses identity local frames.
        # Masses are shared from ./Robotiq_2F_140_body_mass_physics.usda (a subLayer).
        over "left_outer_finger" (
            kind = "group"
        )
        {
            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/left_outer_knuckle>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/left_outer_finger>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "right_outer_finger" (
            kind = "group"
        )
        {
            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/right_outer_knuckle>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/right_outer_finger>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}

# Collision-group plumbing: keep the shared /Meshes colliders from colliding with
# the articulation-body copies (same pattern as the 2F-85).
over "Meshes"
{
    def PhysicsCollisionGroup "CollisionGroup"
    {
        rel collection:colliders:includes = </Meshes>
        rel physics:filteredGroups
    }

    def PhysicsCollisionGroup "CollisionGroup_01"
    {
        rel collection:colliders:includes = </Robotiq_2F_140>
        rel physics:filteredGroups = </Meshes/CollisionGroup>
    }

    # PhysX convex-hull colliders for the nine body links, on the baked per-link
    # meshes in the shared /Meshes scope (moved here from body_mass so that layer is
    # engine-neutral; same layout as the 2F-85).
    over "base_link"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "left_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "right_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "left_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "right_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "left_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "right_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "left_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }

    over "right_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
        }
    }
}
