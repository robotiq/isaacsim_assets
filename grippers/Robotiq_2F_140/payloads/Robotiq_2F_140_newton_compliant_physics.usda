#usda 1.0
(
    defaultPrim = "Robotiq_2F_140"
    doc = """Newton (MuJoCo-Warp) compliant physics for the Robotiq 2F-140.

Thin overlay on the shared Newton four-bar (./Robotiq_2F_140_newton_fourbar_physics.usda:
loop_closure spherical equalities, inner_finger pad springs, right_outer_knuckle NewtonMimic,
finger_joint drive, root_joint + articulation root, Mjc tuning) over the shared Newton-pure
bodies/colliders (./Robotiq_2F_140_newton_common_physics.usda) and the neutral joint frames
(./Robotiq_2F_140_kinematics_physics.usda).

This variant's ONLY delta is keeping the four-bar's distal coupler DOF live: the
left/right_outer_finger_joint revolutes remain active (with MuJoCo tuning), so the linkage
closes by wrapping around the object -- the compliant / encompassing grip. The parallel
variant instead suppresses + welds those joints.

Mirrors the 2F-85 Newton variant of the same name; only the 2F-140 values differ.

RV.011: shared Newton+MuJoCo tuning (from the fourbar layer) -- the mjc:* params tune the
MuJoCo-Warp (Newton) solver; no Physx* data here."""
    metersPerUnit = 1
    subLayers = [
        @./Robotiq_2F_140_newton_fourbar_physics.usda@,
        @./Robotiq_2F_140_newton_common_physics.usda@,
        @./Robotiq_2F_140_body_mass_physics.usda@,
        # fingertip_physics only authors values nothing else overrides, so its slot is arbitrary.
        @./Robotiq_2F_140_fingertip_physics.usda@,
        @./Robotiq_2F_140_kinematics_physics.usda@,
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        over "Joints"
        {
            # Compliant: the distal coupler DOF stays live. These revolutes are the
            # four-bar's distal joints (the shared fourbar layer leaves outer_finger_joint
            # untouched so each variant decides its fate). MuJoCo tuning only; the neutral
            # frames/limits/bodies come from the kinematics layer.
            over "left_outer_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.00707, 2]
            }

            over "right_outer_finger_joint" (
                prepend apiSchemas = ["MjcJointAPI"]
            )
            {
                uniform double mjc:armature = 0
                uniform double mjc:damping = 0
                uniform double[] mjc:solimplimit = [0.95, 0.99, 0.001, 0.5, 2]
                uniform double[] mjc:solreflimit = [0.00707, 2]
            }
        }
    }
}
