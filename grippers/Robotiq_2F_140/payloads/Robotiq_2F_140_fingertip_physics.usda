#usda 1.0
(
    # Shared fingertip physics for the 2F-140: the screwed-on fingertip rigid
    # bodies, their PhysicsFixedJoints (welded to inner_finger, rigid like a
    # screw), the default Flat-Overmolded pad mass/inertia, and the tip collider.
    # Identical for the parallel_grip and compliant variants, so it lives here once
    # and is sublayered by both. All link frames are identity/world, so the welds
    # use identity local frames.
    #
    # Mass/inertia for the Flat-Overmolded pad are authored here (not in the
    # "Fingertip" variantSet) so they are reachable on the configuration/
    # integration path, which sublayers this payload + base.usda but never
    # Robotiq_2F_140.usda. The Silicone / V-Groove / Tactile_TSF140 Fingertip
    # variants override them with their own values. The tip collider is authored
    # here too so it composes only when a Physics variant is selected -- never
    # under Physics = "None".
    #
    # Pad mass/CoM: CoM is the baked pad geometry centre; mass + inertia are
    # box-model estimates for the overmolded pad (refine against CAD if needed).
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        over "left_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {
            point3f physics:centerOfMass = (0, -0.0799, 0.1768)
            float3 physics:diagonalInertia = (0.0000153, 0.0000036, 0.0000165)
            float physics:mass = 0.04
            quatf physics:principalAxes = (1, 0, 0, 0)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/left_inner_finger>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/left_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }

        over "right_fingertip" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            kind = "group"
        )
        {
            point3f physics:centerOfMass = (0, 0.0793, 0.1772)
            float3 physics:diagonalInertia = (0.0000153, 0.0000036, 0.0000165)
            float physics:mass = 0.04
            quatf physics:principalAxes = (1, 0, 0, 0)

            def PhysicsFixedJoint "FixedJoint"
            {
                rel physics:body0 = </Robotiq_2F_140/Robotiq_2F_140/right_inner_finger>
                rel physics:body1 = </Robotiq_2F_140/Robotiq_2F_140/right_fingertip>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
            }
        }
    }
}

# Tip colliders for every Fingertip variant. Only the tip that the selected
# "Fingertip" variant activates actually exists in the composed stage; the other
# overs are inert. Authored here (not in the variant payloads) so no tip collider
# ever composes under Physics = "None".
over "Meshes"
{
    over "fingertip_left"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
            }
        }
    }
}
