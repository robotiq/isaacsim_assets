#usda 1.0
(
    doc = """Visual-only dowel pins of the Robotiq_2F_140 parallel-grip variants (PhysX and Newton),
one per finger, rigidly attached to the driver link (outer_knuckle) so they move with
it. Payload of both *_parallel_grip Physics variants; no physics, no collision.

Tune each pin with its xformOp:translate / xformOp:orient / xformOp:scale (link frame,
metres). The pin part is a 3 x 12 mm cylinder along local Z (../parts/Robotiq_2F_140_dowel_pin.usda)."""
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robotiq_2F_140" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_140"
    {
        over "left_outer_knuckle"
        {
            def Xform "dowel_pin" (
                instanceable = false
                kind = "subcomponent"
                prepend references = @../parts/Robotiq_2F_140_dowel_pin.usda@
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865475, 0)
                float3 xformOp:scale = (2, 2, 2.2799999713897705)
                double3 xformOp:translate = (0, -0.053593422098636066, 0.05649770690182608)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }

        over "right_outer_knuckle"
        {
            def Xform "dowel_pin" (
                instanceable = false
                kind = "subcomponent"
                prepend references = @../parts/Robotiq_2F_140_dowel_pin.usda@
            )
            {
                quatd xformOp:orient = (0.7071067811865476, 0, 0.7071067811865475, 0)
                float3 xformOp:scale = (2, 2, 2.2799999713897705)
                double3 xformOp:translate = (0, 0.053593422098636066, 0.05649770690182608)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }
        }
    }
}
