#usda 1.0
(
    # "tsf140" fingertip variant: deactivate the default flat tip and reference the
    # tsf140 tip parts (baked into the Isaac frame at the pad mount). The tip
    # collider is authored (inert) in Robotiq_2F_140_physx_common_physics.usda so it
    # composes only under a PhysX Physics variant. The fingertip rigid-body mass is the
    # shared value from fingertip_physics (refine per-tip later).
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

over "Meshes"
{
    over "fingertip_left"
    {
        over "tip_flat" (
            active = false
        )
        {
        }

        def Xform "tip_tsf140" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_2F_140_fingertip_tsf140_left.usd@
        )
        {
        }
    }

    over "fingertip_right"
    {
        over "tip_flat" (
            active = false
        )
        {
        }

        def Xform "tip_tsf140" (
            instanceable = false
            kind = "subcomponent"
            prepend references = @../parts/Robotiq_2F_140_fingertip_tsf140_right.usd@
        )
        {
        }
    }
}

# The TSF-140 sensor pads open less than the standard fingertips (132 mm pad to pad, measured on the composed mesh).
over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        over "base_link"
        {
            over "grip_frame"
            {
                float gripper_maxOpening = 0.132
            }
        }
    }
}
