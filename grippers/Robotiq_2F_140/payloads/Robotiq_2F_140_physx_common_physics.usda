#usda 1.0
(
    # PhysX-only physics shared by the 2F-140 Physx_parallel_grip and Physx_compliant
    # variants: the PhysX articulation API, the collision-group
    # plumbing, and the PhysX collision schemas on every collider -- the nine body-link
    # colliders and the tip collider of each Fingertip variant (which meshes collide, as
    # UsdPhysics convex hulls, is the engine-neutral
    # ./Robotiq_2F_140_collision_physics.usda). Identical across both PhysX grip
    # formulations, so it lives here once and is sublayered by both; the grip-specific
    # content (mimics, outer_finger welds, drive tuning) stays in each variant payload.
    #
    # Everything here carries Physx* schemas, so Newton variants never sublayer it (RV.011);
    # they author their own Newton colliders in ./Robotiq_2F_140_newton_common_physics.usda.
    # The engine-neutral fingertip bodies/mass/welds live in
    # ./Robotiq_2F_140_fingertip_physics.usda. Only the tip collider of the selected
    # "Fingertip" variant exists in the composed stage; the other tip overs are inert.
    # None of this composes under Physics = "None".
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    subLayers = [
        @./base.usda@
    ]
    upAxis = "Z"
)

def Xform "Robotiq_2F_140" (
    kind = "assembly"
)
{
    over Xform "Robotiq_2F_140" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        kind = "assembly"
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0

        # root_joint and PhysicsArticulationRootAPI are the shared neutral defs in
        # ./Robotiq_2F_140_kinematics_physics.usda; this layer adds the PhysX articulation API.

        # PhysX joint content identical in both PhysX grip variants, so they cannot drift
        # apart: the finger_joint drive API, zero targets and velocity cap (deg/s), and
        # the right_outer_knuckle mimic wiring. Drive gains, armature and the mimic
        # stiffness stay in each variant payload.
        over "Joints"
        {
            over "finger_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysicsDriveAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 0
                float drive:angular:physics:targetVelocity = 0
                float physxJoint:maxJointVelocity = 86
            }

            # The right finger follows finger_joint through a PhysX mimic (gearing -1,
            # mirror). Its stiffness (naturalFrequency / dampingRatio) is per variant.
            over "right_outer_knuckle_joint" (
                prepend apiSchemas = ["PhysxJointAPI", "PhysxMimicJointAPI:rotZ"]
            )
            {
                float physxJoint:maxJointVelocity = 10000
                float physxMimicJoint:rotZ:gearing = -1
                rel physxMimicJoint:rotZ:referenceJoint = </Robotiq_2F_140/Robotiq_2F_140/Joints/finger_joint>
            }
        }
    }
}

# Collision-group plumbing: keep the shared /Meshes colliders from colliding with
# the articulation-body copies (same pattern as the 2F-85).
over "Meshes"
{
    def PhysicsCollisionGroup "CollisionGroup"
    {
        rel collection:colliders:includes = </Meshes>
        rel physics:filteredGroups
    }

    def PhysicsCollisionGroup "CollisionGroup_01"
    {
        rel collection:colliders:includes = </Robotiq_2F_140>
        rel physics:filteredGroups = </Meshes/CollisionGroup>
    }

    # PhysX collision schemas for the nine body-link colliders, on the baked per-link
    # meshes in the shared /Meshes scope (moved here from body_mass so that layer is
    # engine-neutral; same layout as the 2F-85).
    over "base_link"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "left_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "right_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "left_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "right_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "left_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "right_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "left_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "right_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    # Tip colliders for every Fingertip variant (authored here, not in the variant payloads,
    # so no tip collider ever composes under Physics = "None").
    over "fingertip_left"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }
    }
}
