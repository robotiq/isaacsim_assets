        )
        {
        }
    }

    over "right_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
        )
        {
        }
    }

    over "fingertip_left"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysxCollisionAPI", "PhysxConvexHullCollisionAPI"]
            )
            {
            }
        }

        over "tip_vgroove"
        {
