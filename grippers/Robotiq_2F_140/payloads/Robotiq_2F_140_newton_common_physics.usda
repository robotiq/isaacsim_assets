#usda 1.0
(
    # Newton-pure physics shared by the 2F-140 Newton_compliant and Newton_parallel_grip
    # variants: the isotropic inertia override, the GripMaterial pad friction, and the
    # Newton collision schemas on every collider (+ the pad material binding). Mass + CoM
    # come from ./Robotiq_2F_140_body_mass_physics.usda and the fingertip bodies from
    # ./Robotiq_2F_140_fingertip_physics.usda (both shared with PhysX). Only UsdPhysics +
    # Newton* here, no Physx*/Mjc* (RV.011); the MuJoCo tuning is in
    # ./Robotiq_2F_140_newton_fourbar_physics.usda. Generated by
    # devel_helpers/gen_2f_layers.py.
    defaultPrim = "Robotiq_2F_140"
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        # Newton's intentional isotropic (0.001)^3 diagonal inertia (identity principal
        # axes, overridden together for RB.COL.004) on the moving links, over the shared
        # mass layer. It stabilizes the soft loop-closure equalities; see
        # ../newton/README.md.
        over "left_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        over "right_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        over "left_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        # Fingertip pad friction. The fourbar overlay adds MjcMaterialAPI.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:staticFriction = 0.7
                float newton:rollingFriction = 0.0001
                float newton:torsionalFriction = 0.005
            }
        }
    }
}

over "Meshes"
{
    over "base_link"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "left_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "right_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "left_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "right_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "left_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "right_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "left_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "right_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            float newton:contactGap = 0
        }
    }

    over "fingertip_left"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["NewtonCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }
}
