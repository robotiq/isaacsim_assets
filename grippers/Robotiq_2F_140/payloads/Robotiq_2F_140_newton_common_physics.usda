#usda 1.0
(
    defaultPrim = "Robotiq_2F_140"
    doc = """Shared Newton-pure physics for the Robotiq 2F-140, common to every Newton
grip formulation (newton_compliant, newton_parallel_grip, ...).

Single source of truth for the Newton-tuned values that are identical across those
variants: the isotropic diagonal inertia / principalAxes override for the eight moving
finger-chain links (outer_knuckle, outer_finger, inner_knuckle, inner_finger), the GripMaterial
pad friction, and the per-mesh convex-hull colliders (+ pad material binding).
Sublayered by each Newton variant payload, together with the fourbar layer:
  * newton_fourbar (both variants): the four-bar loop closures, the
    PhysicsFilteredPairsAPI on outer_finger (loop-closure self-collision exclusion),
    and all MuJoCo tuning -- MjcMaterialAPI on GripMaterial, MjcCollisionAPI + mjc:*
    solver params on the mesh colliders.
  * newton_parallel_grip only: the FixedJoint weld on outer_finger (rigid
    coupler), with the outer_finger joints deactivated.
  * newton_compliant only: the outer_finger joint tuning.

Every link's MASS + CoM (and its RigidBody/Mass APIs) comes from
./Robotiq_2F_140_body_mass_physics.usda, and the fingertip bodies + their inner_finger welds from
./Robotiq_2F_140_fingertip_physics.usda; both are shared with the PhysX variants and not re-authored
here (the Newton variant payloads sublayer them). This layer is Newton-pure: only UsdPhysics +
Newton* schemas, no Physx*/Mjc* (RV.011); the Mjc tuning lives in the fourbar overlay.

Mass provenance (2F-140): there is no standalone Newton 2F-140 model to port from (the
2F-85's Newton masses came from one, which is why the 2F-85 re-authors them), so the
2F-140 Newton variants simply inherit the real mass + CoM from the shared mass layer,
with the 2F-85's intentional isotropic (0.001)^3 diagonal inertia + identity principal
axes (solver-stability tuning for the soft loop-closure equalities -- see ../newton/README.md).
Fingertips use the 2F-140 Flat-Overmolded pad values (from the shared fingertip layer).
"""
    metersPerUnit = 1
    upAxis = "Z"
)

over "Robotiq_2F_140"
{
    over "Robotiq_2F_140"
    {
        # Newton overrides only the outer_knuckle inertia (from the shared mass layer) with
        # its intentional isotropic (0.001)^3 solver-stability value. base_link keeps its CAD
        # inertia from the shared mass layer: it is the fixed/welded base, so its inertia is inert.
        over "left_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        over "right_outer_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        }

        # outer_finger / inner_knuckle / inner_finger: mass, CoM and the RigidBody/Mass APIs
        # are inherited from ./Robotiq_2F_140_body_mass_physics.usda (the 2F-140's real values);
        # Newton overrides only the inertia with the isotropic (0.001)^3 solver-stability value
        # (identity principalAxes, overridden together for RB.COL.004). The attachment
        # (parallel weld vs compliant filteredPairs) is added per-variant.
        over "left_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "left_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_outer_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_knuckle"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        over "right_inner_finger"
        {
            float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
            quatf physics:principalAxes = (1, 0, 0, 0)
        }

        # Fingertip pad friction. The compliant overlay adds MjcMaterialAPI.
        def Scope "Physics"
        {
            def Material "GripMaterial" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.7
                float physics:staticFriction = 0.7
                float newton:rollingFriction = 0.0001
                float newton:torsionalFriction = 0.005
            }
        }
    }
}

# Convex-hull colliders cooked from the shared visual CAD meshes (the baked per-link mesh_0
# in /Meshes). Newton-pure here; the fourbar layer adds MjcCollisionAPI + mjc:* params.
# Every fingertip type gets a collider; only the one the Fingertip variant activates composes.
over "Meshes"
{
    over "base_link"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "left_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "right_outer_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "left_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "right_outer_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "left_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "right_inner_finger"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "left_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "right_inner_knuckle"
    {
        over "mesh_0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
            bool physics:collisionEnabled = 1
            float newton:contactGap = 0
        }
    }

    over "fingertip_left"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }

    over "fingertip_right"
    {
        over "tip_flat"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_silicone"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_vgroove"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }

        over "tip_tsf140"
        {
            over "mesh_0" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI", "MaterialBindingAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
                bool physics:collisionEnabled = 1
                rel material:binding:physics = </Robotiq_2F_140/Robotiq_2F_140/Physics/GripMaterial>
                float newton:contactGap = 0
            }
        }
    }
}
