#usda 1.0
(
    doc = """Placeholder dowel pin for the Robotiq_2F_140 parallel-grip variants: a plain 3 x 12 mm
cylinder (axis = local Z, centred on the origin) bound to the shared Silver_Rust steel
material from ../materials/materials.usd, like the gripper's screws. Scale / position it
through the xformOps of the dowel_pin prims in ../payloads/Robotiq_2F_140_parallel_grip_dowel_pins.usda."""
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @../materials/materials.usd@
    ]
    upAxis = "Z"
)

over "World"
{
    def Cylinder "dowel_pin" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.012
        double radius = 0.0015
        rel material:binding = </World/Looks/Silver_Rust>
    }
}
